[96.737, "o", "\u2800\u001b[38;5;243m\u28b8\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2811\u001b[38;5;41m\u2022\u001b[38;5;146m\u28fc\u2832\u2864\u28c0\u28c0\u001b[38;5;243m\u2807\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u2833\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u28c0\u001b[39m\u2800\u2800\u001b[38;5;146m\u2808\u2812\u2844\u001b[39m\u2800\u2800\u2800\u001b[11;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281f\u281b\u28bb\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;243m\u28e7\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;243m\u2813\u28a6\u28c0\u2824\u001b[38;5;41m\u2022\u001b[38;5;243m\u2804\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;243m\u28bf\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u28ab\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;243m\u2808\u001b[38;5;41m\u2022\u001b[38;5;243m\u280d\u001b[38;5;41m\u2022\u001b[38;5;146m\u28a0\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u2880\u28f8\u001b[38;5;153m\u2880\u28c0\u2860\u2824\u2824\u280a\u001b[39m\u2800\u001b[38;5;153m\u2809\u2812\u2824\u28c0\u001b[38;5;146m\u2808\u2811\u28c4\u001b[39m\u2800\u001b[12;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28df\u001b[38;5;41m\u2022\u001b[38;5;69m\u2840\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;69m\u2801\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;69m\u2801\u001b[38;5;41m\u2022\u001b[38;5;243m\u2814\u2856\u2836\u2814\u281a\u28c6\u2814\u2844\u2880\u2863\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;243m\u2811\u2884\u001b[38;5;41m\u2022\u2022\u2022\u001b[3