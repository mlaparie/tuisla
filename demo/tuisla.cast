[115.451, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2812\u001b[38;5;41m\u2022\u001b[38;5;146m\u2819\u2831\u28c0\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28cf\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u28e0\u001b[39m\u2800\u001b[38;5;146m\u28a0\u2803\u001b[39m\u2800\u2800\u001b[38;5;146m\u2840\u2880\u001b[39m\u2800\u2800\u001b[38;5;146m\u2888\u28f1\u2847\u2808\u2886\u2811\u28b2\u001b[39m\u2800\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[12;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u287f\u001b[38;5;41m\u2022\u001b[38;5;69m\u283f\u001b[38;5;146m\u2826\u2864\u2803\u001b[39m\u2800\u2800\u001b[38;5;146m\u2890\u2825\u28a2\u2840\u28c0\u28c0\u28c0\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2818\u280a\u2822\u001b[38;5;69m\u28ff\u28ff\u2843\u001b[39m\u2800\u001b[38;5;146m\u2823\u2840\u284f\u2808\u2801\u2809\u2809\u2829\u2843\u001b[39m\u2800\u2800\u001b[38;5;146m\u28ba\u001b[39m\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[13;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2824\u2814\u2812\u280a\u001b[39m\u2800\u2800\u001b[38;5;146m\u2808\u001b[39m\u2800\u2800\u001b[38;5;146m\u2888\u001b[38;5;69m\u2846\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28e6\u28f4\u28fe\u28fd\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2840\u2880\u2830\u2841\u001b[39m\u2800\u2800\u001b[38;5;146m\u2888\u2806\u001b[39m\u2800\u001b[38;5;146m\u28b8\u001b[39m\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[14;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2840\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2807\u001b[39m\u2800\u2800\u001b[38;5;146m\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2880\u28fc\u2845\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u283b\u28ff\u28ff\u28ff\u28e7\u28c4\u001b[38;5;146m\u2874\u280a\u2809\u2801\u28ab\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2838\u2840\u001b[39m\u2800\u001b[38;5;146m\u2887\u001b[39m\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[15;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2822\u280b\u001b[38;5;41m\u2022\u001b[38;5;146m\u28d5\u001b[38;5;69m\u28b4\u28f6\u28f6\u28db\u28ff\u28f7\u28e6\u28f4\u28f6\u28d2\u001b[38;5;146m\u28cb