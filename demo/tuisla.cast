[108.567, "o", "\u001b[48;5;16m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u283b\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u287f\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[32;36H\u001b[49mGlobe: 37.5\u00b0, -141.9\u00b0\u001b[5D"]
[108.568, "o", "\u001b[?25l\u001b[48;5;16m\u001b[2;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2868\u001b[39m\u2800\u001b[38;5;69m\u28b0\u28df\u2802\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u28ae\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28fc\u28ff\u28ff\u28ff\u28ff\u28f7\u28c4\u28c0\u28c4\u2840\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u28ff\u28ff\u28ff\u28ff\u28ff\u283f\u281f\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28ff\u28ff\u28d2\u28c0\u28f4\u287f\u283f\u280b\u2803\u001b[39m\u2800\u2800\u001b[38;5;69m\u28b9\u28ee\u28ff\u28ff\u28f6\u28e6\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u28ff\u28cd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28c4\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u280a\u001b[38;5;69m\u2880\u28fe\u28ff\u28cf\u28ff\u28f6\u001b[38;5;146m\u2819\u280a\u001b[38;5;69m\u28c1\u28e0\u28b6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u283f\u281b\u28db\u28db\u2809\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28e4\u28f4\u2846\u28de\u28ff\u28ff\u28ff\u2841\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2809\u285f\u281b\u2809\u2801\u2809\u001b[39m\u2800\u001b[38;5;69m\u2880\u28d0\u281b\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28a0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u280a\u001b[38;5;69m\u28f0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u2801\u2880\u28c0\u28fd\u28ff\u28ff\u28ff\u28f6\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e6\u28ed\u2805\u001b[39m\u2