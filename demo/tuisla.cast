[108.077, "o", "\u2801\u001b[38;5;250m\u284c\u001b[22;36H\u001b[39m\u2800\u001b[38;5;250m\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2819\u2809\u001b[38;5;146m\u28a8\u2813\u001b[38;5;69m\u28ab\u28c3\u001b[38;5;146m\u2856\u2801\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u280f\u001b[39m\u2800\u001b[38;5;146m\u2801\u001b[39m\u2800\u001b[38;5;146m\u28e7\u285c\u001b[39m\u2800\u001b[38;5;250m\u2820\u2802\u001b[23;36H\u001b[39m\u2800\u001b[38;5;250m\u28b8\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28f6\u28e6\u28e4\u28e4\u28e4\u28fe\u28ff\u28fe\u28f6\u28f7\u28ff\u28f6\u28ee\u28fb\u28ff\u28ff\u28ff\u2844\u001b[39m\u2800\u2800\u001b[38;5;146m\u28b0\u2809\u001b[39m\u2800\u2800\u001b[38;5;250m\u2858\u001b[39m\u2800\u001b[24;36H\u2800\u2800\u001b[38;5;250m\u28bf\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f