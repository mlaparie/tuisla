[118.507, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u280b\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2818\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28e2\u001b[38;5;41m\u2022\u001b[38;5;146m\u280e\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;146m\u2854\u2812\u2809\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u28b0\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u28b9\u2809\u001b[38;5;69m\u28f8\u28ff\u001b[17;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;203mD\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2803\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2827\u2814\u001b[38;5;69m\u28fb\u28ff\u001b[18;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u001b[38;5;41m\u20