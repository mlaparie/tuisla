[129.224, "o", "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u28a2\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2878\u001b[39m\u2800\u001b[9;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Invert              \u001b(B\u001b[m\u001b[36m  i\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28f6\u28f6\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28f6\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28fe\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u288f\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u281b\u2809\u2811\u2832\u2852\u2866\u28b4\u28c0\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;146m\u2860\u2824\u28c0\u28e3\u2840\u001b[10;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Units               \u001b(B\u001b[m\u001b[36m  u\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281f\u001b[38;5;41m\u2022\u001b[38;5;69m\u2801\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u