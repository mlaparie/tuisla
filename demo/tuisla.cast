[117.919, "o", "\u001b(B\u001b[m\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u287f\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28f7\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u2819\u001b[38;5;41m\u2022\u001b[38;5;69m\u289b\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u001b[38;5;146m\u2818\u2824\u2874\u2809\u001b[38;5;69m\u28a1\u001b[38;5;41m\u2022\u001b[38;5;69m\u283a\u28ff\u28ff\u28ff\u287f\u2801\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u001b[24;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2808\u2878\u2802\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u28e4\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u2889\u28d9\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28f7\u28c0\u001b[38;5;146m\u2878\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;69m\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[25;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2880\u2807\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\