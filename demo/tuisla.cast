[126.202, "o", "\u001b[?25l\u001b[H\u001b[90m\u2500\u2500\u001b[32C\u252c\u2500\u2500\u001b(B\u001b[m\u001b[2;34H\u001b[1K\u001b[38;5;41m\u001b[48;5;16m\u001b[2C\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28f0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u285f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28c0\u2840\u001b[39m\u2800\u001b[38;5;69m\u28c8\u28ed\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;146m\u283b\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28ff\u280f\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28fc\u2847\u001b[2;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\u001b[3;34H\u001b[1K\u001b[38;5;41m\u001b[48;5;16m\u001b[2C\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28f0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2801\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u2880\u28f4\u28f6\u28e6\u28f4\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u280a\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2818\u001b[38;5;41m\u2022\u001b[38;5;69m\u2808\u2839\u28ff\u28df\u2813\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28bf\u2840\u001b[3;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n  \u001b[1mtuisla\u001b(B\u001b[m \u001b[2mdemo, read-only mode\u001b(B\u001b[m     \u001b[38;5;41m\u00