[111.094, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u285f\u001b[38;5;69m\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[30;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2818\u28bf\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281b\u281b\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u281f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[31;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u283b\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28c4\u001b[39m\u2800\u001b[38;5;69m\u28b8\u281b\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u287f\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[32;36H\u001b[49mGlobe: 37.5\u00b0, 168.1\u00b0\u001b[5D"]
[111.095, "o", "\u001b[?25l\u001b[48;5;16m\u001b[2;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2880\u001b[38;5;250m\u28fc\u001b[38;5;146m\u2807\u28b8\u28de\u280f\u285f\u2840\u001b[38;5;69m\u2893\u001b[38;5;146m\u2840\u28b0\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2801\u001b[39m\u2800\u2800\u001b[38;5;69m\u283b\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2811\u2884\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u001b[38;5;250m\u28bb\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28a0\u28fe\u001b[38;5;69m\u28e5\u001b[38;5;146m\u2854\u2877\u2819\u2832\u280b\u2808\u2819\u28aa\u281b\u2832\u2842\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2819\u2809\u281b\u281f\u2809\u2809\u281b\u283f\u28ff\u28ff\u28ff\u2876\u2864\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2811\u2884\u2880\u28c0\u2864\u001b[38;5;69m\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b0\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u283b\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28a0\u287f\u001b[38;5;69m\u2809\u001b[38;5;146m\u28f5\u001b[38;5;231m\u284e\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2860\u2803\u001b[39m\u2800\u001b[38;5;146m\u2808\u2826\u281a\u001b[38;5;69m\u28c4\u001b[39m\u2800\u001b[38;5;69m\u2880\u2