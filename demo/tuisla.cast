[105.084, "o", "\u001b(B\u001b[m\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e7\u28cc\u28fb\u28f7\u28c6\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u283f\u28bb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u280b\u28b9\u281d\u284f\u001b[38;5;231m\u28b3\u001b[38;5;69m\u28bf\u284f\u001b[38;5;250m\u284f\u001b[22;36H\u001b[39m\u2800\u001b[38;5;250m\u28bf\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28ff\u28ff\u28ff\u28e6\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28bf\u28ff\u28ff\u28ff\u28ff\u287f\u001b[39m\u2800\u001b[38;5;69m\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u280b\u2801\u001b[39m\u2800\u2800\u001b[38;5;231m\u2898\u28a6\u28b3\u280d\u001b[39m\u2800\u001b[38;5;250m\u2820\u2802\u001b[23;36H\u001b[39m\u2800\u001b[38;5;250m\u28b8\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2819\u281b\u281f\u280b\u001b[38;5;146m\u28b4\u28f9\u001b[38;5;69m\u28ff\u283f\u280b\u285d\u28ff\u28ff\u28ff\u28ff\u28ff\u285f\u2839\u2859\u001b[38;5;146m\u28c0\u2860\u2844\u28e0\u280a\u2818\u280a\u001b[39m\u2800\u2800\u001b[38;5;250m\u2858\u001b[39m\u2800\u001b[24;36H\u2800\u2800\u001b[38;5;250m\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28f6\u28e4\u28e4\u28c4\u28c0\u28e4\u28f6\u28f6\u28c5\u28e4\u28f7\u28f6\u2849\u001b[38;5;146m\u2880\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28bf\u2803\u001b[39m\u2800\u001b[38;5;146m\u2809\u001b[39m\u2800\u001b[38;5;146m\u2898\u2844\u2878\u2801\u001b[39m\u2800\u2800\u2800\u001b[38;5;250m\u2890\u2801\u001b[39m\u2800\u001b[25;36H\u2800\u2800\u001b[38;5;250m\u2838\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28fd\u28ef\u28fd\u28ff\u28e7\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2854\u2809\u2801\u001b[39m\u2800\u2800\u2800\u001b[38;5;250m\u2880\u2805\u001b[39m\u2800\u2800\u001b[26;36H\u2800\u2800\u2800\u001b[38;5;250m\u2839\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\