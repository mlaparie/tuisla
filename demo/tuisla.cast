[105.084, "o", "\u001b(B\u001b[m\u001b[38;5;69m\u001b[48;5;16m\u28e6\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u284e\u2880\u001b[38;5;250m\u289c\u281f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[31;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u283b\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28c6\u28c0\u28c0\u001b[38;5;146m\u28ce\u2860\u001b[38;5;250m\u287a\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[32;36H\u001b[49mGlobe: 37.5\u00b0, -121.9\u00b0"]
[105.084, "o", "\u001b[?25l\u001b[48;5;16m\u001b[2;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2880\u001b[38;5;250m\u28fc\u001b[38;5;69m\u28ff\u289b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ef\u28e6\u28f6\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28f6\u28ff\u28ff\u28c7\u28e5\u28ff\u28ff\u284f\u2809\u001b[39m\u2800\u2800\u001b[38;5;69m\u2819\u283b\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28c5\u28ff\u28cc\u2848\u281b\u283f\u28ff\u28f7\u28dd\u283f\u28ff\u284f\u28bb\u28ff\u28ff\u2866\u2808\u2889\u28db\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28f7\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28a0\u28fe\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u2864\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b0\u001b[38;5;69m\u2809\u280b\u2809\u2809\u2819\u280b\u281b\u2893\u28e6\u28f4\u281f\u281f\u281f\u283b\u2801\u001b[39m\u2800\u001b[38;5;69m\u2801\u28ff\u287f\u28ff\u28fe\u28ff\u287f\u28bf\u28bf\u28ff\u28df\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28a0\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2809\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2807\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2830\u28f6\u28fe\u2806\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2890\u28ff\u28ff\u28ff\u2