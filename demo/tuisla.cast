[109.072, "o", "\u001b[?25l\u001b[48;5;16m\u001b[2;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u287c\u001b[38;5;231m\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2813\u2801\u2880\u2814\u280a\u001b[39m\u2800\u001b[38;5;69m\u2880\u28c0\u28c0\u28c0\u28e0\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u280b\u281b\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u287f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u287f\u283b\u283f\u28b2\u283f\u2807\u2801\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2846\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u2818\u28af\u281b\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28f7\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u281a\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b8\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28b0\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u2804\u28c0\u28e0\u28c0\u2880\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28c0\u2818\u287f\u28ff\u28ff\u28ff\u2809\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2809\u2838\u2849\u280b\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u2880\u28f4\u28f6\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u28bf\u28bf\u28ff\u283f\u283f\u281f\u283f\u28b6\u28e6\u001b[39m\u2800\u2800\u001b[38;5;69m\u2818\u283f\u285a\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28e6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u280a\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28fe\u28df\u2841\u001b[38;5;146m\u2840\u001b[39m\u2800\u001b[38;5;146m\u28c0\u2880\u2873\u001b[39m\u2800\u001b[38;5;69m\u2880\u28e0\u289e\u28fd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u281f\u28db\u28cb\u2880\u001b[39m\u2800\u001b[38;5;69m\u2880\u28c0\u2840\u28f7\u28ff\u28e7\u28f4\u28ff\u28ef\u28d9\u28c3\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2801\u001b[39m\u2800\u001b[38;5;69m\u2810\u28e6\u284f\u001b[39m\u2800\u2800\u001b[38;5;69m\u2840\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2871\u001b[38;5;69m\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28f7\u001b[38;5;69m\u2840\u001b[39m\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[5;36H\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u280f\u001b[39m\u2800\u2800\u001b[38;5;69m\u28f0\u28f6\u28ff\u28ff\u28d8\u28f5\u286f\u001b[38;5;146m\u2808\u001b[38;5;69m\u28c1\u28e4\u28f4\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u2809\u001b[39m\u2800\u001b[38;5;69m\u28e0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u283b\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b8\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2809\u001b[39m\u2800\u2800\u001b[38;5;69m\u281f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28a0\u2840\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28e0\u28e0\u28c0\u28e0\u28c0\u28f7\u001b[39m\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28e7\u001b[39m\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[6;36H\u2800\u2800\u2800\u001b[38;5;250m\u28a0\u285e\u001b[39m\u2800\u2800\u001b[38;5;69m\u28b0\u28ff\u28ff\u28bb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28df\u28e0\u28f4\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e7\u28c4\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28e0\u2882\u28f4\u28c4\u28e0\u28e7\u001b[38;5;146m\u2884\u2860\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2819\u2813\u2804\u001b[38;5;146m\u28c4\u2824\u001b[38;5;69m\u28fd\u285f\u28ff\u285f\u28f7\u28fd\u001b[39m\u2800\u001b[38;5;69m\u2808\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28c7\u001b[39m\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[7;36H\u2800\u2800\u2800\u001b[38;5;250m\u28fe\u001b[38;5;69m\u2841\u2880\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ef\u28e7\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f7\u28ce\u28e8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28fe\u28e6\u001b[38;5;146m\u2884\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2860\u2812\u2809\u001b[39m\u2800\u2800\u001b[38;5;69m\u2809\u001b[39m\u2800\u001b[38;5;69m\u2808\u28b3\u28c4\u280b\u001b[39m\u2800\u2800\u001b[38;5;69m\u2809\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28c6\u001b[39m\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[8;36H\u2800\u2800\u001b[38;5;250m\u28f8\u001b[38;5;69m\u28ff\u28f7\u28ff\u28ff\u28ff\u28ff\u28ff\u28ef\u281f\u281f\u28eb\u28fd\u28ff\u28ff\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28fd\u28ff\u28ff\u28ff\u28ff\u28ef\u28ed\u28fd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e5\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28c0\u2814\u280a\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u001b[38;5;69m\u2840\u001b[39m\u2800\u001b[49m\u001b[48;5;16m\u001b[9;36H\u2800\u001b[38;5;69m\u28a0\u001b[38;5;250m\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28e7\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e4\u28c4\u2840\u001b[38;5;146m\u2880\u2860\u2814\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b9\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28e7\u001b[39m\u2800\u001b[49m\u001b[48;5;16m\u001b[10;36H\u2800\u001b[38;5;250m\u28fe\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ed\u28ed\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u2844\u001b[39m\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[11;36H\u28b0\u001b[38;5;250m\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff"]
[109.072, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28e0\u28f4\u28e6\u28bb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28c7\u001b[39m\u001b[49m\u001b[38;5;250m\u001b[48;5;16m\u001b[12;36H\u28b8\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28fd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28c7\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28d8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28bf\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u001b[39m\u001b[49m\u001b[38;5;250m\u001b[48;5;16m\u001b[13;36H\u28fc\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u001b[39m\u001b[49m\u001b[38;5;250m\u001b[48;5;16m\u001b[14;36H\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28