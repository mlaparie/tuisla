[125.589, "o", "\u001b[?25l\u001b[H\u001b[90m\u2500\u2500\u001b[32C\u252c\u2500\u2500\u001b(B\u001b[m\u001b[2;34H\u001b[1K\u001b[38;5;41m\u001b[48;5;16m\u001b[2C\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u28e4\u28fe\u28ff\u28ff\u287f\u280b\u2801\u001b[39m\u2800\u001b[38;5;69m\u28fc\u28ff\u28e3\u2846\u28ff\u28cf\u28fc\u28ff\u28ff\u28ff\u28ff\u287d\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28e0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u28c0\u28c0\u2880\u280f\u2801\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[2;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\u001b[3;34H\u001b[1K\u001b[38;5;41m\u001b[48;5;16m\u001b[2C\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;69m\u287e\u281f\u2801\u2809\u2809\u001b[39m\u2800\u2800\u001b[38;5;69m\u2820\u28f4\u28fe\u28ff\u28ff\u28fe\u28ff\u28ff\u28ff\u28ff\u287f\u280b\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2820\u28f4\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u285b\u28ff\u2841\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2840\u2868\u2846\u001b[39m\u2800\u001b[38;5;146m\u2809\u2801\u001b[39m\u2800\u2800\u001b[38;5;146m\u2831\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[3;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n  \u001b[1mtuisla\u001b(B\u001b[m \u001b[2mdemo, read-only mode\u001b(B\u001b[m     \u001b[38;5;41m\u001b[48;5;16m\u001