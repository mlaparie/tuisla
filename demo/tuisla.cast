[108.567, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28fb\u28bf\u28f7\u28e6\u28c4\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u283b\u283f\u280b\u001b[38;5;146m\u289a\u281c\u001b[38;5;69m\u28cf\u001b[38;5;146m\u28b4\u001b[38;5;69m\u2819\u28ff\u28ff\u28df\u2847\u001b[39m\u2800\u001b[38;5;146m\u2880\u283f\u001b[38;5;250m\u2898\u001b[21;36H\u28b8\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28c0\u2840\u2840\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u28f4\u28f6\u28ee\u28f4\u28ff\u28f7\u28ee\u28f9\u28ff\u28ff\u2847\u001b[39m\u2800\u001b[38;5;146m\u28b8\u2803\u001b[38;5;250m\u284c\u001b[22;36H\u001b[39m\u2800\u001b[38;5;250m\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u285f\u001b[38;5;146m\u28c0\u28f8\u001b[38;5;250m\u2820\u2802\u001b[23;36H\u001b[39m\u2800\u001b[38;5;250m\u28b8\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff