[126.201, "o", "\u001b[48;5;16m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[17;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;110mNorth Atlantic Ocean\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;203m\u25ef\u001b[38;5;41m\u2022\u001b[38;5;203mDEMO\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28cd\u001b[38;5;41m\u2022\u001b[38;5;146m\u2886\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28b9\u28ff\u28ff\u28ff\u28ff\u281b\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2860\u2833\u2822\u2860\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[18;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2840\u2871\u28c0\u001b[38;5;41m\u2022\u001b[38;5;146m\u28f9\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2820\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u280a\u2887\u001b[39m\u2800\u2800\u001b[38;5;146m\u2810\u2845\u2880\u2840\u001b[39m\u2800\u2800\u2800\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u283f\u283f\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u202