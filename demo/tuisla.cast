[116.064, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u28bb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u281f\u001b[38;5;146m\u2801\u2818\u2832\u287b\u281d\u2808\u001b[38;5;69m\u2809\u280b\u2819\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[18;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u284c\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u280a\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u281f\u2809\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a3\u28c4\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;146m\u28dd\u2860\u001b[38;5;41m\u2022\u001b[38;5;146m\u2855\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u28a0\u001b[38;5;41m\u2022\u001b[38;5;69m\u283f\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146