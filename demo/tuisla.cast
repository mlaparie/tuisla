[105.196, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u281f\u001b[38;5;146m\u28e4\u2840\u2878\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2808\u289d\u2860\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2808\u2822\u2812\u001b[38;5;69m\u28e4\u28fe\u28ff\u2837\u001b[39m\u2800\u001b[38;5;146m\u2818\u2884\u001b[39m\u2800\u001b[38;5;146m\u2856\u2809\u2812\u2809\u2812\u2812\u001b[39m\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[12;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u001b[38;5;214m\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;214m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u287f\u001b[38;5;214m\u2022\u2022\u2022\u001b[38;5;146m\u2809\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[38;5;146m\u2804\u2880\u28c0\u28c0\u2864\u280f\u2801\u2808\u2811\u2812\u2811\u2809\u2831\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28fc\u28ff\u28ff\u28c7\u001b[39m\u2800\u001b[38;5;69m\u28c0\u2864\u001b[38;5;146m\u28a7\u2815\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[38;5;69m\u001b[48;5;16m\u001b[13;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28db\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;214m\u2022\u2022\