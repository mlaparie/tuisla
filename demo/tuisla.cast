[87.278, "o", "\u2800\u2800\u2800\u001b[38;5;71m\u2801\u001b[39m\u2800\u001b[38;5;188m\u2880\u28c8\u28c9\u28d1\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28ff\u28ff\u28ff\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[11;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u284f\u2801\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u28c0\u2874\u2802\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u2886\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28ff\u28ff\u28ff\u28e6\u001b[38;5;229m\u28a3\u001b[39m\u2800\u001b[38;5;222m\u2808\u28e2\u2864\u001b[38;5;229m\u281d\u28bf\u2849\u28c6\u001b[39m\u2800\u2800\u2800\u001b[38;5;222m\u2818\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;188m\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;243m\u28ff\u28ff\u28ff\u2867\u2824\u2824\u2824\u2824\u2824\u2824\u2824\u2824\u2824\u2824\u28bd\u28ff\u28ff\u287f\u2824\u2824\u2824\u2824\u2824\u2824\u001b[12;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u284f\u001b[39m\u2800\u001b[38;5;69m\u2819\u28bf\u281f\u2801\u001b[39m\u2800\u2800\u001b[38;5;69m\u2880\u28d8\u28f6\u2846\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28a3\u001b[38;5;69m\u28e4\u28fc\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u284f\u2801\u001b[39m\u2800\u001b[38;5;229m\u2857\u280b\u2801\u001b[38;5;222m\u2838\u2844\u001b[38;5;250m\u2808\u28a7\u001b[38;5;229m\u2818\u2846\u001b[39m\u2800\u2800\u2800\u001b[38;5;222m\u28b9\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;188m\u283f\u28ff\u28ff\u28ff\u28ff\u001b[38;5;243m\u28ff\u28ff\u28ff\u001b[38;5;188m\u28ff\u287f\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u28bf\u28ff\u28ff\u28f6\u28c6\u28e0\u28e0\u28c4\u001b[39m\u280