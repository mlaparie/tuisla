[110.588, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u2840\u001b[38;5;146m\u28b8\u001b[38;5;69m\u2809\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u280f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[31;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u283b\u28cd\u001b[38;5;69m\u2801\u2819\u282b\u2819\u283b\u28bf\u28ff\u28ff\u28fe\u28c0\u28c0\u2848\u28bb\u28ff\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u280b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[32;36H\u001b[49mGlobe: 37.5\u00b0, 178.1\u00b0\u001b[5D"]
[110.588, "o", "\u001b[?25l\u001b[48;5;16m\u001b[2;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2868\u001b[38;5;231m\u28f4\u001b[38;5;146m\u280a\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2860\u2803\u28a0\u2863\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u281b\u28fb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u280b\u280b\u2809\u2809\u001b[39m\u2800\u001b[38;5;146m\u2823\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u281a\u2803\u001b[39m\u2800\u001b[38;5;69m\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u001b[38;5;146m\u285d\u001b[38;5;69m\u2808\u001b[39m\u2800\u001b[38;5;69m\u2808\u2811\u001b[39m\u2800\u2800\u001b[38;5;69m\u2839\u001b[38;5;250m\u28ff\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u285e\u001b[38;5;231m\u286d\u2803\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2878\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u001b[38;5;69m\u28b3\u28e4\u28e4\u2834\u2802\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u2809\u2819\u281f\u2809\u2819\u283b\u28ff\u28ff\u28ff\u28ef\u28c5\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2884\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u285c\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2839\u001b[38;5;250m\u28ff\u28e7\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u280b\u001b[38;5;146m\u285c\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b0\u2801\u001b[39m\u2800\u2800\u28