[125.589, "o", "\u001b[48;5;16m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2884\u001b[39m\u2800\u001b[38;5;69m\u2879\u2819\u2809\u2809\u283b\u283f\u283f\u28bf\u2806\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u28b1\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u281b\u28bf\u28ff\u28f6\u28e6\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2807\u001b[39m\u2800\u001b[38;5;69m\u28f0\u28ff\u28ff\u28ff\u001b[25;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u2801\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2880\u2860\u281a\u2809\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2808\u287e\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2888\u287b\u28bf\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u2840\u001b[39m\u2800\u001b[38;5;146m\u2860\u2812\u2809\u001b[39m\u2800\u001b[38;5;69m\u28fc\u28ff\u28ff\u28ff\u28ff\u001b[26;36H\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u28bf\u283f\u280b\u001b[38;5;146m\u2860\u2814\u2812\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2838\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2860\u2814\u280a\u2801\u001b[39m\u2800\u001b[38;5;69m\u2808\u28bf\u28ff\u28ff\u28ff\u28ff\u2842\u001b[39m\u2800\u001b[38;5;69m\u28e0\u28fe\u28ff\u281f\u28ff\u28ff\u28ff\u001b[27;36H\u28bc\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281f\u2801\u001b[38;5;146m\u28f4\u28d2\u28d2\u2867\u2884\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2820\u2843\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b8\u2860\u2814\u280a\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2864\u001b[38;5;69m\u281b\u283f\u28ff\u287f\u28b7\u28e4\u28ff\u287f\u288b\u28a7\u28ff\u28ff\u28ff\u001b[28;36H\u001b[38;5;231m\u283c\u28c4\u001b[38;5;69m\u28b9\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2803\u001b[38;5;146m\u2864\u28da\u2847\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2875\u2826\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2892\u2824\u2824\u2860\u2854\u2812\u2824\u2824\u2884\u28c0\u28c0\u001b[39m\u2800\u001b[38;5;146m\u28c8\u2806\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2867\u2814\u280a\u001b[39m\u2800\u001b[38;5;146m\u2828\u001b[38;5;69m\u28fb\u281b\u28cb\u001b[38;5;146m\u2824\u001b[38;5;231m\u285e\u001b[38;5;69m\u28f8\u28ff\u28ff\u28ff\u001b[29;36H\u001b[39m\u2800\u001b[38;5;146m\u2808\u001b[38;5;231m\u282b\u001b[38;5;69m\u2868\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2827\u001b[38;5;146m\u28a4\u28c3\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a3\u001b[39m\u2800\u2800\u001b[38;5;146m\u2809\u2822\u2884\u001