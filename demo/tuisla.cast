[126.793, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28df\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u280b\u001b[38;5;41m\u2022\u001b[38;5;69m\u281b\u001b[38;5;146m\u280a\u2801\u001b[38;5;41m\u2022\u001b[38;5;146m\u2887\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28c0\u28ce\u2801\u001b[39m\u2800\u001b[38;5;146m\u2801\u2818\u2812\u2809\u2809\u001b[39m\u2800\u001b[38;5;146m\u2887\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28ff\u28ff\u28ff\u28f6\u001b[10;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Units               \u001b(B\u001b[m\u001b[36m  u\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28f7\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u287f\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u28b1\u2854\u2812\u280a\u2809\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28ee\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u281b\u283b\u28ff\u28ff\u001b[11;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Style               \u001b(B\u001b[m\u001b[36m  s\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u