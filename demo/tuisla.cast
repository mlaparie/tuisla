[109.577, "o", "\u2809\u281b\u28ff\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u281b\u2819\u2801\u001b[39m\u2800\u001b[38;5;69m\u28e0\u28cd\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u283b\u283b\u287f\u281b\u280b\u2808\u281b\u281b\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2898\u001b[38;5;69m\u283f\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28f7\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[3;36H\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2880\u287e\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2822\u282e\u28e0\u28b9\u2808\u2809\u001b[39m\u2800\u001b[38;5;146m\u2878\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2819\u28bf\u28ff\u28ff\u28df\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2808\u2886\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2818\u283b\u2803\u001b[39m\u2800\u001b[38;5;69m\u2820\u28fc\u2847\u001b[39m\u2800\u2800\u001b[38;5;69m\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28c8\u28e6\u2818\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u28c4\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[49m\u001b[48;5;16m\u001b[4;36H\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u28e0\u287e\u001b[38;5;231m\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2801\u001b[39m\u2800\u2800\u001b[38;5;146m\u2854\u2801\u001b[39m\u2800\u2800\u001b[38;5;69m\u2890\u28f6\u28fe\u28ff\u28ff\u28ff\u28f7\u2866\u2880\u28c0\u28e4\u2844\u28e0\u2844\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28a4\u28f4\u28e6\u28d9\u28ed\u28ff\u285b\u2837\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2810\u281b\u2801