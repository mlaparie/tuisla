[119.293, "o", "\u001b[38;5;69m\u001b[48;5;16m\u2820\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281b\u2809\u281b\u284f\u2809\u2809\u001b[39m\u2800\u2800\u001b[38;5;69m\u2811\u28be\u28e7\u28c4\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2860\u2803\u001b[38;5;69m\u28fd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u2847\u001b[23;36H\u001b[39m\u2800\u001b[38;5;250m\u2838\u287f\u001b[38;5;146m\u28f0\u28fc\u001b[39m\u2800\u001b[38;5;69m\u2808\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u284f\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u28c0\u28f8\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2811\u2884\u2860\u001b[38;5;69m\u280b\u2809\u2809\u281b\u281b\u283b\u2803\u001b[39m\u2800\u2800\u001b[38;5;146m\u28b1\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2819\u28bb\u28ff\u28f7\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;146m\u2880\u28bc\u001b[39m\u2800\u001b[38;5;69m\u28f4\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u001b[38;5;69m\u2801\u001b[24;36H\u001b[39m\u2800\u2800\u001b[38;5;250m\u28bf\u001b[38;5;69m\u28ff\u001b[38;5;146m\u2838\u28f8\u28c6\u001b[38;5;69m\u285e\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u2880\u2860\u2816\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2845\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2847\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2860\u001b[38;5;69m\u281c\u281b\u28ff\u28ff\u28ff\u28e6\u2876\u001b[3