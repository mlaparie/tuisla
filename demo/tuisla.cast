[96.737, "o", "\u001b(B\u001b[m\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28f6\u28e4\u28e4\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;243m\u28c0\u2814\u283c\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u287c\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;243m\u287c\u2801\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;243m\u2809\u2809\u2809\u2808\u2895\u2840\u28c0\u28e0\u280b\u2808\u2809\u2809\u288e\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2803\u001b[39m\u2800\u2800\u001b[38;5;146m\u28e0\u28c4\u28c0\u28c4\u001b[38;5;69m\u2840\u001b[39m\u2800\u001b[38;5;243m\u28c0\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2840\u2880\u28b8\u2840\u001b[39m\u2800\u2800\u2800\u2800\u001b[15;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;243m\u28f6\u2816\u288b\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;243m\u285c\u2809\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[38;5;243m\u28bf\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2822\u001b[38;5;41m\u2022\u001b[38;5;196mZurich\u001b[38;5;69m\u2808\u001b[38;5;146m\u2819\u285f\u2811\u2884\u2854\u2812\u2822\u2824\u2816\u2809\u2809\u2809\u2808\u2809\u283a\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;226m\u25c9\u001b[16;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\