2\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2877\u001b[38;5;146m\u2824\u28a4\u001b[39m\u2800\u2800\u001b[38;5;146m\u28b8\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2896\u2803\u28c0\u2824\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[6;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m   Help                  \u001b(B\u001b[m\u001b[36m  h\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2844\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u287f\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u2827\u001b[38;5;146m\u2812\u2812\u2809\u2831\u2852\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u2813\u2803\u001b[39m\u2800\u001b[38;5;146m\u2811\u2812\u2822\u2860\u2824\u001b[7;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Refresh rate        \u001b(B\u001b[m\u001b[36m+ -\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u28bf\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u281f\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2804\u001b[39m\u2800\u001b[38;5;146m\u2880\u28c0\u28c0\u28c0\u28a4\u2824\u281a\u2802\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[8;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Colors              \u001b(B\u001b[m\u001b[36m  b\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;226mU\u001b[38;5;41m\u2022\u001b[38;5;226mi\u001b[38;5;41m\u2022\u2022\u001b[38;5;226md K\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;226mdom\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2877\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28b1\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;146m\u2808\u28a6\u280e\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[9;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Invert              \u001b(B\u001b[m\u001b[36m  i\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff"]
[128.003, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281b\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2886\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2808\u28b1\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[10;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Units               \u001b(B\u001b[m\u001b[36m  u\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28e0\u28ff\u28ff\u287f\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28c4\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u285c\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u001b[39m\u2800\u001b[38;5;146m\u2880\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[11;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Style               \u001b(B\u001b[m\u001b[36m  s\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f