[128.601, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;226mF\u001b[38;5;41m\u2022\u001b[38;5;226ma\u001b[38;5;41m\u2022\u2022\u001b[38;5;226me\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u281e\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2884\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2880\u2864\u28c0\u001b[38;5;41m\u2022\u001b[38;5;146m\u289c\u28e6\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2808\u2811\u280a\u001b[38;5;41m\u2022\u001b[38;5;146m\u28c4\u001b[38;5;41m\u2022\u001b[38;5;146m\u2824\u2814\u2812\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28df\u28fb\u28ff\u28ff\u28ff\u283f\u283f\u283f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u280a\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2841\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2893\u2864\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2823\u28a4\u001b[39m\u2800\u2800\u2800\u2800\u001b[20;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f