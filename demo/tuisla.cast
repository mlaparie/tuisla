[108.22, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u2022\u2022\u2022\u001b[38;5;203mDE\u001b[38;5;214m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u2022\u001b[38;5;146m\u2803\u001b[38;5;214m\u2022\u001b[38;5;146m\u2801\u001b[38;5;214m\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b0\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[18;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;214m\u2022\u001b[38;5;69m\u28e4\u001b[38;5;214m\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28c0\u001b[38;5;214m\u2022\u001b[38;5;146m\u2884\u001b[38;5;214m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;214m\u2022\u2022\u001b[38;5;146m\u28c0\u280e\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;214m\u2022\u001b[39m\u2800\u2800\u001b[38;5;214m\u2022\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28