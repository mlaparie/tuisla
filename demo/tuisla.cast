[36.233, "o", "\n  \u001b[35m\u001b[1mSecurity\u001b[6;36H\u001b(B\u001b[m  \u001b[36msentry on|off\u001b[39m   \u001b[90mEnable/disable Sentry Mode\u001b[7;36H\u001b[39m  \u001b[36mvalet on|off\u001b[39m   \u001b[90mEnable/disable valet mode (valet on <pwd>)\u001b[8;36H\u001b[39m  \u001b[36mhonk\u001b[39m   \u001b[90mHonk the horn\u001b[9;36H\u001b[39m  \u001b[36mflash\u001b[39m   \u001b[90mFlash the lights\u001b[10;36H\u001b[39m  \u001b[36mremote start\u001b[39m   \u001b[90mRemote start the car\u001b[12;36H\u001b[39m  \u001b[35m\u001b[1mLocking\u001b[13;36H\u001b(B\u001b[m  \u001b[36mlock|unlock\u001b[39m   \u001b[90mLock/unlock the doors\u001b[14;36H\u001b[39m  \u001b[36mwindows vent|close\u001b[39m   \u001b[90mVent/close all windows\u001b[15;36H\u001b[39m  \u001b[36mtrunk toggle|frunk open\u001b[39m   \u001b[90mToggle trunk/open frunk\u001b[17;36H\u001b[39m  \u001b[35m\u001b[1mCharging\u001b[18;36H\u001b(B\u001b[m  \u001b[36mcharge start|stop\u001b[39m   \u001b[90mStart/stop charging\u001b[19;36H\u001b[39m  \u001b[36mcharge limit\u001b[90m <percent>\u001b[39m   \u001b[90mSet charge limit % (e.g. charge limit 80)\u001b[20;36H\u001b[39m  \u001b[36mcharge amps\u001b[90m <charging_amps>\u001b[39m   \u001b[90mSet charging amps (e.g. charge amps 16)\u001b[21;36H\u001b[39m  \u001b[36mport open|close\u001b[39m   \u001b[90mOpen/close the charge port\u001b[23;36H\u001b[39m  \u001b[35m\u001b[1mClimate\u001b[24;36H\u001b(B\u001b[m  \u001b[36mclimate on|off\u001b[39m   \u001b[90mTurn climate on/off\u001b[25;36H\u001b[39m  \u001b[36mtemp\u001b[90m <temp>\u001b[39m   \u001b[90mSet both seats temp (e.g. temp 21)\u001b[26;36H\u001b[39m  \u001b[36mtemp_driver\u001b[90m <temp>\u001b[39m   \u001b[90mSet driver temp only (e.g. temp_driver 21)\u001b[27;36H\u001b[39m  \u001b[36mtemp_passenger\u001b[90m <temp>\u001b[39m   \u001b[90mSet passenger temp only (e.g. temp_passenger 19)\u001b[28;36H\u001b(B\u001b[m  \u001b[36mdefrost on|off\u001b[39m   \u001b[90mEnable/disable max defrost/preconditioning\u001b[29;36H\u001b[39m  \u001b[36mseat heat\u001b[90m <seat> <level>\u001b[39m   \u001b[90mSeat heat: seat 0-4, level 0-3 (e.g. seat heat 0 2)\u001b[30;36H\u001b[39m  \u001b[36msteering heat on|off\u001b[39m   \u001b[90mSteering wheel heater on/off\u001b[31;36H\u001b[39m\u001b[7m COMMANDS  65%  j/k d/u g/G  /search  n/N  q close \u001b[32;36H\u001b(B\u001b[m"]
