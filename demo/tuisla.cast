[126.202, "o", "  \u001b(B\u001b[m\u001b[36m  i\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u287f\u2827\u001b[38;5;146m\u2884\u2880\u280e\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2829\u28c3\u2884\u2840\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2809\u280a\u2822\u001b[38;5;69m\u28ff\u28ff\u284f\u001b[39m\u2800\u2800\u001b[38;5;146m\u2811\u2884\u2887\u001b[39m\u2800\u2800\u2800\u001b[10;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     Units               \u001b(B\u001b[m\u001b[36m  u\u001b[39m     \u001b[38;5;69m\u001b[48;5;16m\u001b[C\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;69m\u281b\u001b[38;5;146m\u280a\u2809\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;146m\u2880\u28e0\u2878\u280d\u001b[39m\u2800\u001b[38;5;146m\u2809\u2812\u280a\u2809\u001b[39m\u2800\u001b[38;5;146m\u28a3\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b8\u28ff\u28ff\u28f6\u28e4\u28e6\u28ee\u28f5\u001b[38;5;146m\u2801\u001b[39m\u2800\u2800\u2800\u001b[11;35H\u001b[49m\u001b[90m\u2502\u001b(B\u001b[m\r\n \u001b[2m     S