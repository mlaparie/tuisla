[111.095, "o", "\u28f7\u28f5\u001b[38;5;146m\u28e3\u2836\u2897\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28b4\u28f6\u28f6\u28c3\u28c0\u001b[38;5;146m\u2860\u2860\u001b[38;5;69m\u28b4\u28ce\u28c4\u28c1\u28e4\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28f7\u001b[39m\u001b[49m\u001b[38;5;250m\u001b[48;5;16m\u001b[12;36H\u28b8\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u280f\u001b[38;5;146m\u28a1\u2812\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28d8\u28dd\u28ff\u28ff\u2887\u28b4\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u289b\u2801\u28fb\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u001b[39m\u001b[49m\u001b[38;5;250m\u001b[48;5;16m\u001b[13;36H\u28fc\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u001b[39m\u2800\u001b[38;5;146m\u2880\u2807\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28a8\u28ff\u28ff\u28ff\u28ff\u2803\u28b9\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u285f\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28