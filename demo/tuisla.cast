[101.573, "o", "\u001b(B\u001b[m\u001b[38;5;146m\u001b[48;5;16m\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2809\u284f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2807\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u280a\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u286a\u28b7\u2803\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u2854\u001b[38;5;69m\u2881\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u287f\u001b[38;5;69m\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[30;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u28a3\u001b[38;5;146m\u2840\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u281b\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u001b[38;5;146m\u283e\u28d6\u28c0\u2847\u2809\u2809\u2809\u2812\u280b\u001b[39m\u2800\u001b[38;5;146m\u2880\u2860\u2824\u2864\u2814\u281a\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u001b[39m\u2800\u001b[38;5;146m\u28f0\u28c5\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2818\u2844\u001b[39m\u2800\u001b[38;5;146m\u2860\u2860\u001b[38;5;231m\u2864\u281c\u001b[38;5;146m\u281a\u001b[39m\u2800\u001b[38;5;146m\u281e\u2824\u2840\u28c0\u28c0\u28ae\u280b\u001b[38;5;69m\u28f0\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u281f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[31;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u2823\u2840\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2809\u283b\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28cd\u001b[38;5;146m\u2880\u28c9\u2812\u28a3\u2840\u28c0\u2860\u280b\u28c1\u28c0\u28c0\u2818\u2872\u28b4\u2809\u2809\u2809\u2811\u280a\u2801\u2809\u28a0\u289d\u28c7\u001b[39m\u2800\u2800\u001b[38;5;146m\u28c0\u28c0\u280e\u2818\u2835\u2885\u2840\u001b[39m\u28