[119.293, "o", "\u001b[38;5;69m\u001b[48;5;16m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u2813\u001b[38;5;146m\u2812\u2884\u2880\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28b8\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2878\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2856\u2801\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2838\u2841\u001b[39m\u2800\u001b[38;5;146m\u2880\u2880\u001b[38;5;231m\u28c0\u2854\u001b[38;5;146m\u281a\u001b[39m\u2800\u001b[38;5;146m\u283e\u001b[38;5;231m\u2884\u001b[38;5;146m\u28c0\u28c0\u2870\u28b9\u001b[38;5;69m\u28a1\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u287f\u001b[38;5;69m\u2803\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[30;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u28b3\u001b[38;5;146m\u2884\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2819\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2876\u001b[38;5;146m\u28f6\u2840\u2887\u2809\u2809\u2809\u2809\u2809\u2880\u2860\u2814\u2812\u2896\u2809\u2809\u28a1\u2824\u28c0\u2824\u28c0\u2860\u2824\u2814\u28b7\u2844\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2854\u2809\u28e6\u2843\u2801\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u2852\u2801\u001b[39m\u2800\u2800\u001b[38;5;69m\u28f8\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;250m\u28ff\u281f\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[31;36H\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;250m\u2808\u283b\u28c6\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;69m\u2808\u283b\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28cd\u001b[38;5;146m\u2888\u28c9\u2811\u283a\u28c4\u28c0\u28b0\u2801\u2880\u28c0\u2824\u28ec\u281b\u2812\u2847\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28a0\u2