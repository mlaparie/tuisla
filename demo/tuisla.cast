[94.997, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;111m\u28ff\u28ff\u28ff\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28e4\u28c4\u001b[39m\u2800\u2800\u2800\u001b[38;5;41m\u25a0\u001b[39m\u2800\u001b[38;5;41mVannes, France\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u28f0\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u2860\u280a\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u2808\u2811\u2822\u2840\u001b[38;5;243m\u2818\u28ab\u001b[39m\u2800\u2800\u001b[20;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;111m\u28ff\u28ff\u28ff\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28f6\u28f7\u28c0\u28c0\u2840\u001b[39m\u2800\u001b[38;5;243m\u28c0\u2870\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;243m\u28a0\u2812\u281a\u2809\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u2880\u2860\u280a\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u2808\u28a2\u001b[38;5;243m\u287c\u2804\u001b[39m\u2800\u001b[21;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;111m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;243m\u281f\u281a\u2801\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;153m\u2880\u28c0\u28c0\u28c0\u28c0\u28c0\u001b[38;5;41m\u25a0\u001b[38;5;153m\u28c0\u28c0\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;243m\u28b8\u001b[39m\u2800\u2800\u2800\u001b[