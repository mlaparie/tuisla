[128.002, "o", "\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u281b\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2886\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2808\u28b1\u2844\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[12;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28e0\u28ff\u28ff\u287f\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28c4\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;146m\u285c\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u001b[39m\u2800\u001b[38;5;146m\u2880\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[13;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e7\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u282b\u2817\u2813\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2824\u2812\u2822\u2857\u001b[39m\u2800\u2800\u2800\u2800\u001