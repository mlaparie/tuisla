[128.002, "o", "\u001b(B\u001b[m\u001b[38;5;41m\u001b[48;5;16m\u2022\u2022\u2022\u001b[38;5;203m\u25ef\u001b[39m\u2800\u001b[38;5;203mDEMO\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2884\u001b[38;5;41m\u2022\u001b[38;5;146m\u28ce\u2801\u2818\u001b[38;5;41m\u2022\u001b[38;5;146m\u2844\u2880\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2824\u2812\u280a\u001b[38;5;69m\u28fe\u28ff\u28ff\u28ff\u28ff\u001b[18;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;226ma\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2801\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2874\u2812\u001b[38;5;41m\u2022\u001b[38;5;146m\u283a\u28c7\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2809\u2801\u2877\u2824\u2812\u2812\u2809\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28bf\u28ff\u28ff\u28ff\u28ff\u001b[19;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28ff\u28ff\u28ff\u28ef\u28ed\u28fd\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28fb\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u2844\u001b[39m\u2800\u2800\u2800\u