[128.602, "o", "\u001b[38;5;41m\u001b[48;5;16m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u2844\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;226mal\u001b[38;5;41m\u2022\u001b[38;5;69m\u28bf\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u2840\u001b[38;5;146m\u28b8\u001b[39m\u2800\u001b[38;5;146m\u2880\u2824\u281a\u001b[38;5;41m\u2022\u001b[38;5;69m\u2820\u28fe\u001b[23;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u2846\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;69m\u2808\u001b[38;5;41m\u2022\u001b[38;5;69m\u2809\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u2816\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u280f\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28ff\u28f6\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;69m\u2809\u001b[38;5;41m\u2022\u001b[38;5;69m\u283f\u283f\u28ff\u28ff\u28ff\u28ff\u28c7\u001b[39m\u2800\u001b[38;5;146m\u28a9\u2803\u001b[39m\u2800\u2800\u001b[38;5;69m\u28b7\u28e6\u28f4\u001b[24;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;146m\u28a2\u001b[38;5;41m\u2022\u001b[38;5;146m\u2864\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2819\u2812\u001b[38;5;41m\