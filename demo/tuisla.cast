[116.704, "o", "\u001b[48;5;16m\u2800\u001b[38;5;146m\u2818\u28b2\u283a\u286b\u2807\u2809\u001b[38;5;69m\u2809\u001b[18;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u282a\u2859\u001b[38;5;41m\u2022\u001b[38;5;146m\u2844\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;146m\u2860\u2812\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u281b\u281b\u281b\u001b[38;5;41m\u2022\u001b[38;5;69m\u281b\u2801\u001b[39m\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2831\u2840\u001b[39m\u2800\u2800\u2800\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u284b\u2809\u2809\u28a3\u001b[38;5;41m\u2022\u2022\u001b[38;5;146m\u283b\u2852\u280a\u2809\u001b[39m\u2800\u001b[38;5;146m\u2880\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u287f\u2803\u001b[38;5;41m\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28f0\u280a\u280b\u2812\u2824\u2840\u001b[20;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u287f\u281f\u281b\u283b\u001b[38;5;41m\u2022\u001b[38;5;6