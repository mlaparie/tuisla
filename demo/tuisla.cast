[126.792, "o", "\u001b(B\u001b[m\u001b[38;5;41m\u001b[48;5;16m\u2022\u2022\u001b[38;5;203m\u25ef\u001b[38;5;41m\u2022\u001b[38;5;203mDEMO\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28ce\u2809\u001b[38;5;41m\u2022\u001b[38;5;146m\u28c0\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[38;5;146m\u280a\u001b[38;5;69m\u28b1\u28ff\u28ff\u28ff\u28ff\u28ff\u281f\u2809\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u28c0\u2835\u001b[18;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u284b\u2801\u2808\u2863\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[38;5;146m\u2899\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u001b[38;5;146m\u2860\u001b[38;5;69m\u28bf\u001b[38;5;41m\u2022\u2022\u2022\u2022\u001b[39m\u2800\u001b[38;5;41m\u2022\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2860\u2892\u2807\u001b[39m\u2800\u001b[19;36H\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;69m\u28e4\u28cf\u001b[38;5;146m\u287d\u28c4\u281f\u28a2\u28c0\u001b[38;5;41m\u2022\u001b[38;5;69m\u28ec\u001b[38;5;41m\u2022\u2022\u2