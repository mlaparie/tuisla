[125.587, "o", "\u001b[48;5;16m\u2800\u001b[38;5;146m\u2808\u280a\u2873\u001b[38;5;69m\u28a0\u001b[17;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;110mNorth Atlantic Ocean\u001b[38;5;69m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u001b[38;5;203m\u25ef\u001b[38;5;41m\u2022\u001b[38;5;203mDEMO\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28eb\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u28b9\u28ff\u28ff\u28ff\u281f\u001b[38;5;41m\u2022\u2022\u001b[39m\u2800\u2800\u2800\u2800\u001b[38;5;146m\u2880\u281c\u2822\u2824\u2840\u001b[39m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u001b[38;5;69m\u28f1\u28ff\u001b[18;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;146m\u28f8\u28f4\u001b[38;5;41m\u2022\u2022\u2022\u001b[38;5;146m\u28d0\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[39m\u2800\u2800\u001b[38;5;146m\u2880\u2814\u2819\u2844\u001b[39m\u2800\u001b[38;5;146m\u2808\u2826\u2824\u2840\u001b[39m\u2800\u001b[38;5;69m\u2840\u001b[39m\u2800\u2800\u2800\u001b[38;5;69m\u28f4\u28e6\u28fe\u28ff\u28ff\u001b[19;36H\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[38;5;41m\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u001b[38;5;69m\u283f\u001b[38;5;41m\u2