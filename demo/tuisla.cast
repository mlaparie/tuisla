[47.753, "o", "\u001b[30;1H  \u001b[2mKeys pressed:\r\n\u001b(B\u001b[m   j  /  c  l  i  m  a  t  e \u001b[1m\u001b[7m \u23ce \u001b[2;36H\u001b(B\u001b[m  \u001b[35m\u001b[1mCharging\u001b[3;36H\u001b(B\u001b[m  \u001b[36mcharge start|stop\u001b[39m   \u001b[90mStart/stop charging\u001b[4;36H\u001b[39m  \u001b[36mcharge limit\u001b[90m <percent>\u001b[39m   \u001b[90mSet charge limit % (e.g. charge limit 80)\u001b[5;36H\u001b[39m  \u001b[36mcharge amps\u001b[90m <charging_amps>\u001b[39m   \u001b[90mSet charging amps (e.g. charge amps 16)\u001b[6;36H\u001b[39m  \u001b[36mport open|close\u001b[39m   \u001b[90mOpen/close the charge port\u001b[8;36H\u001b(B\u001b[m\u001b[33m\u001b[1m  Climate\u001b[9;36H\u001b(B\u001b[m  \u001b[36m\u001b[7mclimate\u001b(B\u001b[m on|off   \u001b[90mTurn \u001b[7mclimate\u001b(B\u001b[m on/off\u001b[10;36H  \u001b[36mtemp\u001b[90m <temp>\u001b[39m   \u001b[90mSet both seats temp (e.g. temp 21)\u001b[11;36H\u001b[39m  \u001b[36mtemp_driver\u001b[90m <temp>\u001b[39m   \u001b[90mSet driver temp only (e.g. temp_driver 21)\u001b[12;36H\u001b(B\u001b[m"]
[47.753, "o", "  \u001b[36mtemp_passenger\u001b[90m <temp>\u001b[39m   \u001b[90mSet passenger temp only (e.g. temp_passenger 19)\u001b[13;36H\u001b[39m  \u001b[36mdefrost on|off\u001b[39m   \u001b[90mEnable/disable max defrost/preconditioning\u001b[14;36H\u001b[39m  \u001b[36mseat heat\u001b[90m <seat> <level>\u001b[39m   \u001b[90mSeat heat: seat 0-4, level 0-3 (e.g. seat heat 0 2)\u001b[15;36H\u001b[39m  \u001b[36msteering heat on|off\u001b[39m   \u001b[90mSteering wheel heater on/off\u001b[17;36H\u001b[39m  \u001b[35m\u001b[1mSettings\u001b[18;36H\u001b(B\u001b[m  \u001b[36mspeed limit on|off\u001b[90m <pin>\u001b[39m   \u001b[90mActivate/deactivate speed limit\u001b[19;36H\u001b[39m  \u001b[36mspeed limit set|clear\u001b[39m   \u001b[90mSet limit mph 50-90/clear PIN\u001b[20;36H\u001b[39m  \u001b[36msunroof vent|close\u001b[39m   \u001b[90mVent/close the sunroof\u001b[22;36H\u001b(B\u001b[m"]
