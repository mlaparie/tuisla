# ── Arg parsing ───────────────────────────────────────────────────────────────
usage() {
    printf 'teslui — Tesla status TUI\n\n'
    printf '  ./teslui [--mode MODE] [--unit UNIT] [--invert] [--fancy]\n\n'
    printf 'Options:\n'
    printf '  -m, --mode ro|mtm|vc         Command mode: read-only (default), MyTeslaMate (nonfree), vehicle-command\n'
    printf '  -u, --unit metric|us         Set units (metric: km, °C, bar; imperial: mi, °F, psi)\n'
    printf '  -i, --invert                 Start in inverted color mode\n'
    printf '  -t, --text                   Disable fancy style\n'
    printf '  -b, --bw                     Disable colors\n\n'
    printf '  TESLA_REFRESH_TOKEN      Required env var\n'
    printf '  TESLA_VIN                Optional: pin to a vehicle\n'
    exit 0
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode|-m)
                shift
                case "${1:-}" in
                    ro|readonly|read-only)
                        MODE=ro ;;
                    mtm|myteslamate)
                        MODE=mtm ;;
                    vc|vehicle-command|vehiclecommand) MODE=vc ;;
                    *) printf 'Unknown mode: %s\n' "${1:-}" >&2; usage ;;
                esac ;;
	    --unit|-u)
		shift
		case "${1:-}" in
		    metric|m) UNIT=metric ;;
		    us) UNIT=us ;;
		    *)  UNIT=metric ; printf 'Unknown unit: %s. Defaulting to metric.\n' "${1:-}" >&2 ;;
		esac ;;
	    --invert|-i) INVERTED=1; setup_colors ;;
            --text|-t)   FANCY=0 ;;
	    --bw|-b)     BW=1; setup_colors ;;
            --help|-h)   usage ;;
            *) printf 'Unknown arg: %s\n' "$1" >&2; usage ;;
        esac
        shift
    done
}

# ── Handle a keypress ─────────────────────────────────────────────────────────
# Wait for input
read_key() {
    local key
    if read -r -s -n1 -t "$REFRESH_INTERVAL" key 2>/dev/null; then
        printf '%s' "$key"
        return 0
    fi
    printf ''   # timeout — empty string signals refresh
    return 1
}

# Returns 0 = redraw current data, 1 = fetch fresh data
handle_key() {
    local key="$1" vid="$2"
    case "$key" in
        q|Q)
            tput rmcup 2>/dev/null; tput cnorm 2>/dev/null; printf '\e[?5l'; exit 0 ;;
        '?')
            SHOW_HELP=$(( 1 - SHOW_HELP ))
            return 0 ;;
        i)
            INVERTED=$(( 1 - INVERTED ))
            setup_colors
            return 0 ;;
        b)
            BW=$(( 1 - BW ))
            setup_colors
            return 0 ;;
        m)
            case "$MODE" in
                ro)  MODE=mtm ;;
                mtm) MODE=vc ;;
                vc)  MODE=ro ;;
                *)   MODE=ro ;;
            esac
            return 0 ;;
	u)
	    case "$UNIT" in
		metric) UNIT=us ;;
		us)     UNIT=metric ;;
		*)      UNIT=metric ;;
	    esac
	    return 0 ;;
	s)
            FANCY=$(( 1 - FANCY ))
            return 0 ;;
        r)
            SHOW_HELP=0
            return 1 ;;   # fetch fresh
        +)
            REFRESH_INTERVAL=$(( REFRESH_INTERVAL + 5 ))
            (( REFRESH_INTERVAL == 6 )) && REFRESH_INTERVAL=5
            return 0 ;;

        -)
            REFRESH_INTERVAL=$(( REFRESH_INTERVAL - 5 ))
            (( REFRESH_INTERVAL <= 1 )) && REFRESH_INTERVAL=1
            return 0 ;;
    esac
    if [[ "$MODE" != "ro" && $SHOW_HELP -eq 0 ]]; then
	case "$key" in
	    h) run_cmd "$vid" "honk_horn"               "NOOT NOOT!" ;;
	    f) run_cmd "$vid" "flash_lights"            "Lights flashed" ;;
	    L) run_cmd "$vid" "door_unlock"             "Unlocked" ;;
	    l) run_cmd "$vid" "door_lock"               "Locked" ;;
	    C) run_cmd "$vid" "auto_conditioning_start" "Climate on" ;;
	    c) run_cmd "$vid" "auto_conditioning_stop"  "Climate off" ;;
	    p) run_cmd "$vid" "charge_start"            "Charging started" ;;
	    P) run_cmd "$vid" "charge_stop"             "Charging stopped" ;;
	    o) run_cmd "$vid" "charge_port_door_open"   "Port opened" ;;
	    :)
		# Use the line above the last one to avoid scroll on Enter
		tput cup $(($(tput lines) - 2)) 0
		tput el
		printf "${C_B}:${C_R} "
		tput cnorm
		local cmd_input=""
		read -r cmd_input
		# Cancel if user typed Esc then Enter (ESC is ASCII 27)
		[[ "$cmd_input" == $'\e' ]] && cmd_input=""
		tput civis

		# Clear the prompt line after reading
		tput cup $(($(tput lines) - 2)) 0
		tput el

		case "$cmd_input" in
		    honk)            run_cmd "$vid" "honk_horn"                  "NOOT NOOT!" ;;
		    flash)           run_cmd "$vid" "flash_lights"               "Lights flashed" ;;
		    lock)            run_cmd "$vid" "door_lock"                  "Locked" ;;
		    unlock)          run_cmd "$vid" "door_unlock"                "Unlocked" ;;
		    climate\ on)     run_cmd "$vid" "auto_conditioning_start"    "Climate on" ;;
		    climate\ off)    run_cmd "$vid" "auto_conditioning_stop"     "Climate off" ;;
		    charge\ on)      run_cmd "$vid" "charge_start"               "Charging started" ;;
		    charge\ off)     run_cmd "$vid" "charge_stop"                "Charging stopped" ;;
		    port\ open)      run_cmd "$vid" "charge_port_door_open"      "Port opened" ;;
		    port\ close)     run_cmd "$vid" "charge_port_door_close"     "Port closed" ;;
		    trunk)           run_cmd "$vid" "actuate_trunk"              "Trunk" ;;
		    frunk)           run_cmd "$vid" "actuate_trunk"              "Frunk" ;;
		    sentry\ on)      run_cmd "$vid" "set_sentry_mode"            "Sentry on" ;;
		    sentry\ off)     run_cmd "$vid" "set_sentry_mode"            "Sentry off" ;;
		    vent)            run_cmd "$vid" "window_control"             "Windows vented" ;;
		    "")              ;;  # cancelled with enter on empty
		    *)               CMD_MSG="? help    ${C_RED}Unknown command: ${cmd_input}${C_R}" ;;
		esac
		;;
	esac
    fi
    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    parse_args "$@"
    check_deps

    # Defensive re-read for export timing edge cases
    [[ -z "$REFRESH_TOKEN" && -n "${TESLA_REFRESH_TOKEN:-}" ]] && REFRESH_TOKEN="$TESLA_REFRESH_TOKEN"
    [[ -z "$TARGET_VIN"    && -n "${TESLA_VIN:-}"           ]] && TARGET_VIN="$TESLA_VIN"

    # Enter alternate screen, hide cursor
    tput smcup 2>/dev/null
    tput civis 2>/dev/null
    trap 'tput rmcup 2>/dev/null; tput cnorm 2>/dev/null; exit 0' INT TERM EXIT

    # Demo mode
    # Demo mode (no token → use DEMO_DATA forever)
    if [[ -z "$REFRESH_TOKEN" ]]; then
	local key
	while true; do
            if [[ $SHOW_HELP -eq 1 ]]; then
		render_help
            else
		render "$DEMO_DATA" "$UNIT"
            fi

            key=$(read_key || true)
            handle_key "$key" "" || true
	done
    fi

    # Validate mode deps
    [[ "$MODE" == "mtm" && -z "$MYTESLAMATE_TOKEN" ]] && \
        die "MYTESLAMATE_TOKEN not set"

    # Auth + vehicle lookup — done before entering TUI
    tput rmcup 2>/dev/null; tput cnorm 2>/dev/null
    trap - EXIT
    printf 'Authenticating…\n'
    refresh_access_token
    printf 'Looking up vehicle…\n'
    local vid; vid=$(get_vehicle_id)
    [[ -z "$vid" || "$vid" == "null" ]] && die "No vehicle found — check TESLA_VIN or token"
    printf 'Connected: %s [%s]\n' "$vid" "$MODE"
    sleep 1

    # Re-enter TUI
    tput smcup 2>/dev/null; tput civis 2>/dev/null
    trap 'tput rmcup 2>/dev/null; tput cnorm 2>/dev/null; exit 0' INT TERM EXIT

    local data="" key rc
    while true; do
        # Fetch fresh data
        data=$(get_data "$vid")
        if [[ -z "$data" ]]; then
            wake_up "$vid"
            data=$(get_data "$vid")
        fi
        [[ -z "$data" ]] && { sleep 5; continue; }

        # Inner redraw loop: keep displaying same data until timeout triggers refetch
        while true; do
            if [[ $SHOW_HELP -eq 1 ]]; then
                render_help
            else
                render "$data" "$UNIT"
            fi

            key=$(read_key); rc=$?
            if [[ $rc -ne 0 || -z "$key" ]]; then
                break   # timeout → fetch fresh data
            fi

            handle_key "$key" "$vid"; rc=$?
            [[ $rc -ne 0 ]] && break   # r pressed → fetch fresh
        done
    done
}

main "$@"
