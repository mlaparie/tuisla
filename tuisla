@dataclasses.dataclass
class State:
    mode: str = "ro"
    unit: str = "metric"
    refresh_interval: int = 5
    show_help: bool = False
    cmd_msg: str = ""
    cmd_msg_at: float = 0.0      # when cmd_msg was first shown
    prompt_row: int = 0          # row of the last status line, set by flush_frame
    prompt_col: int = 0          # col of the prompt cursor, set by render_dashboard
    target_vin: str = ""
    myteslamate_token: str = ""
    vid: str = ""                # vehicle id for data requests
    vc: Optional[VcBackend] = None               # set when vc mode is set up
    min_refresh: int = 1
    last_data: Optional[Dict[str, Any]] = None   # last vehicle_data shown, for set_temps
    data_at: float = 0.0         # when last_data was fetched
    route_until: float = 0.0     # ask for the location (and route) until then
    route: Dict[str, Any] = dataclasses.field(default_factory=dict)  # active_route_* from fetch_route
    watch_until: float = 0.0     # fetch data until then even if the car may sleep (after a command)
    status: str = ""             # shown on the message line while nothing else is
    jobs: Any = None             # queue of commands sent in the background (live mode)
    redraw: Optional[Callable[[], None]] = None  # asks the main loop to redraw
    pending: int = 0             # commands queued or being sent
    let_sleep: bool = True       # only poll the state while the car is idle, so it can sleep
    charger_range_km: Optional[float] = None     # chargers range in km; None: the car's range
    map_country: str = ""        # mapscii country's argument; "": the car's country
    notify: Optional[Callable[[str], None]] = None   # shows progress on the message line


# =============================================================================
#  Render: help overlay
# =============================================================================

def render_help(term: Term, c: Colors, st: State) -> None:
    term_w, _ = term.get_size()
    lbl_w, val_w = 9, 20
    col_w    = 2 + lbl_w + val_w
    content_w = min((col_w * 2 + 2), term_w)

    frame = Frame(content_w=content_w, lbl_w=lbl_w)
    frame.blank()

    def kcap(k: str, desc: str) -> str:
        return f"{c.REV} {k:<1} {c.R} {desc}"

    frame.section(c, "TUISLA")
    frame.row2(c, kcap("m", "mode"),        "", kcap("u", "units"),    "")
    frame.row2(c, kcap("r", "refresh"),     "", kcap("s", "style"),    "")
    frame.row2(c, kcap("-", "refresh -5s"), "", kcap("i", "invert"),   "")
    frame.row2(c, kcap("+", "refresh +5s"), "", kcap("b", "bw/color"), "")
    frame.row2(c, kcap("q", "quit"),        "", kcap("W", "keep awake"), "")

    cmd_frame = Frame(content_w=content_w, lbl_w=lbl_w)
    cmd_frame.section(c, "COMMANDS")
    cmd_frame.row2(c, kcap("H", "honk"),        "", kcap("f", "flash lights"), "")
    cmd_frame.row2(c, kcap("L", "unlock"),      "", kcap("o", "open port"),    "")
    cmd_frame.row2(c, kcap("l", "lock"),        "", kcap("p", "charge start"), "")
    cmd_frame.row2(c, kcap("C", "climate on"),  "", kcap("P", "charge stop"),  "")
    cmd_frame.row2(c, kcap("c", "climate off"), "", kcap("w", "wake"),         "")
    cmd_frame.row2(c, kcap(":", "enter command"), "", kcap("?", "all commands"), "")
    cmd_frame.row1(c, kcap("z", "show log"), "")

    frame.maxvis = max(frame.maxvis, cmd_frame.maxvis)

    for s in cmd_frame.lines:
        frame.fline(s)

    frame.blank()
    frame.row2(c, "mode:",    f"{c.GRY}{st.mode}{'' if st.let_sleep else ', awake'}{c.R}",
                  "style:",   f"{c.GRY}{'fancy' if c.fancy else 'minimal'}{c.R}")
    frame.row2(c, "refresh:", f"{c.GRY}{st.refresh_interval}s{c.R}",
                  "colors:",  f"{c.GRY}{'inv' if c.inverted else 'normal'}{'/bw' if c.bw else '/col'}{c.R}")
    frame.blank()
    frame.row1(c, f"{c.GRY}h close help{c.R}", "")

    flush_frame(term, c, frame)


