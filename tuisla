def run_cmd(client: TeslaClient, st: "State", ep: str, label: str,
            body: Optional[Dict[str, Any]], c: Colors) -> str:
    if st.mode == "ro":
        msg    = "X commands disabled in ro mode (press m)"
        result = f"h help    {c.RED}{msg}{c.R}"
        log_cmd(ep, msg)
        return result

    try:
        if st.mode == "mtm":
            if not st.target_vin:
                msg    = "X TESLA_VIN missing"
                result = f"h help    {c.RED}{msg}{c.R}"
                log_cmd(ep, msg)
                return result
            if not st.myteslamate_token:
                msg    = "X MyTeslaMate token missing (run: tuisla --login-mtm)"
                result = f"h help    {c.RED}{msg}{c.R}"
                log_cmd(ep, msg)
                return result
            url  = (
                f"https://api.myteslamate.com/api/1/vehicles"
                f"/{urllib.parse.quote(st.target_vin)}/command/{ep}"
                f"?token={urllib.parse.quote(st.myteslamate_token)}"
            )
            # MyTeslaMate authenticates with its own token; don't send ours.
            resp = client.api_post(url, body, auth=False)
        elif st.mode == "vc":
            if not st.target_vin:
                msg    = "X TESLA_VIN required for vc"
                result = f"h help    {c.RED}{msg}{c.R}"
                log_cmd(ep, msg)
                return result
            cafile = st.vehicle_command_cert or "cert.pem"
            ctx    = ssl.create_default_context(cafile=cafile)
            base   = st.vehicle_command_url.rstrip("/")
            url    = f"{base}/api/1/vehicles/{urllib.parse.quote(st.target_vin)}/command/{ep}"
            try:
                resp = client.api_post(url, body, ctx=ctx)
            except RuntimeError as e:
                if not str(e).startswith("HTTP 401"):
                    raise
                # Access token expired since the last data fetch; renew once.
                client.refresh_access_token()
                resp = client.api_post(url, body, ctx=ctx)
    except Exception as e:
        msg    = f"X {str(e)[:180]}"
        result = f"h help    {c.RED}{msg}{c.R}"
        log_cmd(ep, msg)
        return result

    ok     = bool(jget(resp, "response.result", False))
    reason = str(jget(resp, "response.reason", "") or jget(resp, "response.string", "")
                 or jget(resp, "error", "") or "failed")
    msg    = (f"✓ {label}") if ok else (f"X {reason}")
    result = f"h help    {c.GRN if ok else c.RED}{msg}{c.R}"
    log_cmd(ep, msg)
    return result


# =============================================================================
#  Interactive command prompt  (raw-mode, tab-complete, Esc to cancel)
#
#  Tab-completion uses CMD_KEYS (static key names, no <placeholders>).
#  Algorithm (bash-style):
#    1. Compute LCP of all keys that start with the current buffer.
#    2. If LCP extends the buffer -> fill to LCP, no candidate list yet.
#    3. If already at LCP (no progress) -> show candidates on line above.
#    4. Unique match at any point -> fill entire key + trailing space.
# =============================================================================

def prompt_command(term: Term, c: Colors, st: "State") -> Optional[str]:
    """Returns the typed string, or None if cancelled (Esc/idle timeout)."""
    term_w, term_h = term.get_size()
    lbl_w   = 9
    col_w   = 2 + lbl_w + 20
    content_w = min(col_w * 2 + 2, term_w)
    margin  = max(0, (term_w - min(content_w, term_w)) // 2)

    row = st.prompt_row
    col = st.prompt_col          # right after "h help" label
    avail = term_w - col - 2     # chars available on the prompt line

    buf: List[str] = []

    def erase_prompt() -> None:
        term.move(row, col)
        term.write("\x1b[K")     # erase to end of line

    def redraw() -> None:
        erase_prompt()
        term.write(f"{c.B}:{c.R} {''.join(buf)}")

    def erase_candidates() -> None:
        for r in (row + 1, row + 2, row + 3):
            term.move(r, margin)
            term.write("\x1b[K")

    term.cursor(True)
    redraw()

    import select as _sel

    while True:
        try:
            r, _, _ = _sel.select([sys.stdin], [], [], 120)
        except Exception:
            break
        if not r:
            break

        ch = sys.stdin.read(1)

        if ch == "\x1b":
            erase_prompt()
            erase_candidates()
            term.cursor(False)
            return None

        if ch in ("\r", "\n"):
            erase_prompt()
            erase_candidates()
            term.cursor(False)
            return "".join(buf).strip()

        if ch in ("\x7f", "\x08"):
            if buf:
                buf.pop()
                redraw()
            continue

        if ch == "\t":
            partial = "".join(buf)
            matches = [k for k in CMD_KEYS if k.startswith(partial)]

            if not matches:
                pass
            elif len(matches) == 1:
                buf = list(matches[0]) + [" "]
                erase_candidates()
                redraw()
            else:
                lcp = _longest_common_prefix(matches)
                if lcp != partial:
                    buf = list(lcp)
                    erase_candidates()
                    redraw()
                else:
                    # Collapse alias siblings, then wrap across up to 4 lines
                    displayed: List[str] = []
                    seen_alias: set = set()
                    for m in matches:
                        alias = next(
                            (d for d, (_, keys) in _PAGER_ALIASES.items() if m in keys),
                            None
                        )
                        if alias:
                            if alias not in seen_alias:
                                seen_alias.add(alias)
                                displayed.append(re.split(r"\s+<", alias)[0])
                        else:
                            displayed.append(m)
                    erase_candidates()
                    line_w = content_w - 2
                    out_lines: List[str] = [""]
                    for token in displayed:
                        tok = token + "  "
                        if len(out_lines[-1]) + len(tok) > line_w:
                            if len(out_lines) >= 4:
                                out_lines[-1] = out_lines[-1].rstrip() + "  (+ more)"
                                break
                            out_lines.append("")
                        out_lines[-1] += tok
                    for i, ln in enumerate(out_lines):
                        term.move(row + 2 + i, margin + 5)
                        term.write(f"{c.GRY}{ln.rstrip()}{c.R}")
                    redraw()
            continue

        if ch.isprintable():
            buf.append(ch)
            redraw()

    erase_prompt()
    erase_candidates()
    term.cursor(False)
    return None


def parse_and_run_cmd(term: Term, c: Colors, client: TeslaClient,
                      st: "State") -> str:
    """
    Prompt -> parse -> dispatch to run_cmd.
    Typing "help" opens the command pager (same as pressing ?).
    """
    raw = prompt_command(term, c, st)
    if raw is None or raw == "":
        return ""

    # "help" at the prompt -> open command pager inline
    if raw.strip().lower() == "help":
        show_cmd_pager(term, c)
        return ""

    tokens = raw.strip().split()

    # Find the longest matching static prefix key
    best_key: Optional[str]              = None
    best_ep:  Optional[str]              = None
    best_tpl: Optional[Dict[str, Any]]   = None
    best_args: List[str]                 = []
    best_len: int                        = -1

    for key, (ep, tpl, _help, arg_names) in _CMD_LOOKUP.items():
        key_tokens = key.split()
        n = len(key_tokens)
        if tokens[:n] == key_tokens and n > best_len:
            best_key  = key
            best_ep   = ep
            best_tpl  = tpl
            best_args = arg_names
            best_len  = n

    if best_key is None or best_ep is None:
        result = f"h help    {c.RED}Unknown command: {raw}{c.R}"
        log_cmd(raw, result)
        return result

    def fail(msg: str) -> str:
        result = f"h help    {c.RED}X {msg}{c.R}"
        log_cmd(best_ep or raw, result)
        return result

    arg_tokens = tokens[best_len:]
    if len(arg_tokens) < len(best_args):
        return fail(f"missing argument <{best_args[len(arg_tokens)]}> for '{best_key}'")

    args: Dict[str, Any] = {}
    for name, raw_val in zip(best_args, arg_tokens):
        if name in ("pin", "password"):      # keep leading zeros
            args[name] = raw_val
            continue
        try:
            args[name] = int(raw_val)
        except ValueError:
            try:
                args[name] = float(raw_val)
            except ValueError:
                args[name] = raw_val

    body: Optional[Dict[str, Any]] = None
    if best_tpl is not None:
        body = {}
        for k, v in best_tpl.items():
            m = re.fullmatch(r"<(\w+)>", v) if isinstance(v, str) else None
            body[k] = args[m.group(1)] if m else v

    if best_ep == "set_temps" and body is not None:
        for k in ("driver_temp", "passenger_temp"):
            if body[k] is None:
                # set_temps needs both seats; keep the other one as it is now
                cur = jget(st.last_data or {}, f"response.climate_state.{k}_setting", None)
                if cur is None:
                    return fail(f"current {k.split('_')[0]} temp unknown -- use 'temp'")
                body[k] = float(cur)
            elif not isinstance(body[k], (int, float)):
                return fail(f"temperature must be a number, got '{body[k]}'")
            elif st.unit == "us" and best_tpl and best_tpl[k] is not None:
                body[k] = round((body[k] - 32) * 5 / 9, 1)

    label = best_key[0].upper() + best_key[1:]
    return run_cmd(client, st, best_ep, label, body, c)


