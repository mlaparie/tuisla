HOTKEYS: Dict[str, Tuple[str, str]] = {
    "H": ("honk_horn",               "NOOT NOOT!"),
    "f": ("flash_lights",            "Lights flashed"),
    "L": ("door_unlock",             "Unlocked"),
    "l": ("door_lock",               "Locked"),
    "C": ("auto_conditioning_start", "Climate on"),
    "c": ("auto_conditioning_stop",  "Climate off"),
    "p": ("charge_start",            "Charging started"),
    "P": ("charge_stop",             "Charging stopped"),
    "o": ("charge_port_door_open",   "Port opened"),
}


def handle_key(term: Term, c: Colors, st: State, client: Optional[TeslaClient],
               key: Optional[str]) -> bool:
    """Returns True if the caller should fetch fresh vehicle data."""
    if key is None:
        return True                         # timeout -> refresh

    if key in ("q", "Q"):
        raise KeyboardInterrupt

    # h = help (was ?)
    if key == "h":
        st.show_help = not st.show_help
        return False

    # ? = full command pager -- runs inline (blocks until user quits)
    if key == "?":
        show_cmd_pager(term, c)
        return False

    # z = log pager -- runs inline (blocks until user quits)
    if key == "z":
        show_log_pager(term, c)
        return False

    if key == "i":
        c.inverted = not c.inverted
        c.apply_bw()
        term.invert_screen(c.inverted)
        return False

    if key == "b":
        c.bw = not c.bw
        c.apply_bw()
        return False

    if key in ("m", "M"):
        st.mode = {"ro": "mtm", "mtm": "vc", "vc": "ro"}.get(st.mode, "ro")
        return False

    if key == "u":
        st.unit = "us" if st.unit == "metric" else "metric"
        return False

    if key == "W":
        st.let_sleep = not st.let_sleep
        st.cmd_msg = (f"h help    {c.GRN}✓ The car may sleep when idle{c.R}"
                      if st.let_sleep else f"h help    {c.GRN}✓ Keeping the car awake{c.R}")
        st.cmd_msg_at = 0.0
        return not st.let_sleep             # keeping it awake starts at once

    if key == "s":
        c.fancy = not c.fancy
        return False

    if key == "r":
        st.show_help = False
        return True

    if key == "+":
        st.refresh_interval += 5
        if st.refresh_interval == 6:
            st.refresh_interval = 5
        return False

    if key == "-":
        st.refresh_interval = max(st.min_refresh, st.refresh_interval - 5)
        return False

    # Command hotkeys -- only when the help overlay is closed
    if not st.show_help and (key in HOTKEYS or key in (":", "w")):
        if key == ":":
            st.cmd_msg = parse_and_run_cmd(term, c, client, st)
        elif key == "w":                    # wake once; it falls asleep again later
            st.cmd_msg = run_cmd(client, st, "wake_up", "Waking the car", None, c)
        else:
            st.cmd_msg = run_cmd(client, st, *HOTKEYS[key], None, c)
        st.cmd_msg_at = 0.0                 # a new message starts its own 3 s
        st.watch_until = time.time() + WATCH
        return True                         # force immediate refresh after any command

    return False


# =============================================================================
#  Main
# =============================================================================

def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("-m", "--mode",    choices=["ro", "mtm", "vc"],
                    help="Where commands go (default: mtm, or vc when only vc is set up)")
    ap.add_argument("-u", "--unit",    default="metric", choices=["metric", "us"])
    ap.add_argument("-r", "--refresh", type=int, default=5, metavar="SECONDS",
                    help="Refresh interval in s (default: 5)")
    ap.add_argument("-i", "--invert",  action="store_true")
    ap.add_argument("-W", "--keep-awake", action="store_true",
                    help="Keep the car awake instead of letting it sleep when idle")
    ap.add_argument("-s", "--simple",  action="store_true", help="Disable fancy style")
    ap.add_argument("-b", "--bw",      action="store_true", help="Disable colors")
    ap.add_argument("-c", "--color",   action="store_true", help=argparse.SUPPRESS)  # now the default
    ap.add_argument("-l", "--login",   action="store_true",
                    help="Sign in to Tesla, then set up MyTeslaMate or vc mode for commands")
    ap.add_argument("--login-tesla",   action="store_true",
                    help="Sign in to Tesla and save a refresh token, then exit")
    ap.add_argument("--login-mtm",     action="store_true",
                    help="Save a MyTeslaMate API token (from their API tab), then exit")
    ap.add_argument("--print",         action="store_true",
                    help="With --login-tesla: print the Tesla token instead of saving it")
    ap.add_argument("--setup-vc",      action="store_true",
                    help="Step-by-step setup of vc mode (own key and Tesla developer app)")
    args = ap.parse_args()

    if args.login or args.login_tesla:
        return login(print_token=args.print, then_mtm=args.login and not args.print)
    if args.login_mtm:
        return login_mtm()
    if args.setup_vc:
        setup_vc()

    st = State(
        mode=args.mode or "mtm",
        unit=args.unit,
        refresh_interval=max(1, args.refresh),
        let_sleep=not args.keep_awake,
        target_vin=os.environ.get("TESLA_VIN", "") or "",
        myteslamate_token=os.environ.get("MYTESLAMATE_TOKEN", "") or load_token(MTM_TOKEN_FILE),
    )

    # TESLA_REFRESH_TOKEN wins if set; the saved token is the fallback.
    env_token   = os.environ.get("TESLA_REFRESH_TOKEN", "") or ""
    saved_token = load_token()
    refresh_token = env_token or saved_token

    vc_cfg   = load_vc_config()
    fleet_rt = load_token(FLEET_TOKEN_FILE)
    if vc_cfg.get("client_id") and vc_cfg.get("fleet_api") and fleet_rt:
        st.vc = VcBackend(fleet_client(vc_cfg, fleet_rt),
                          os.environ.get("VEHICLE_COMMAND_URL", ""),
                          os.environ.get("VEHICLE_COMMAND_CERT", "") or "cert.pem")
        st.target_vin = st.target_vin or vc_cfg.get("vin", "")
        if not args.mode and not st.myteslamate_token:
            st.mode = "vc"                  # set up instead of MyTeslaMate
    elif st.mode == "vc":
        die("vc mode is not set up yet; run: tuisla --setup-vc")
    c = Colors(fancy=(not args.simple), inverted=bool(args.invert), bw=args.bw)

    term   = Term()
    client: Optional[TeslaClient] = None
    vid    = ""

    term.alt_screen(True)
    term.cursor(False)
    term.invert_screen(c.inverted)
    term.enable_raw()

    def cleanup() -> None:
        for fn in (
            lambda: term.disable_raw(),
            lambda: term.cursor(True),
            lambda: term.invert_screen(False),
            lambda: term.alt_screen(False),
            lambda: st.vc and st.vc.stop(),
        ):
            try: fn()
            except Exception: pass

    err = ""
    try:
        # DEMO MODE
        if not refresh_token and st.vc is None:
            while True:
                if st.show_help:
                    render_help(term, c, st)
                else:
                    render_dashboard(term, c, st, DEMO_DATA)
                handle_key(term, c, st, None, term.read_key_timeout(st.refresh_interval))

        # LIVE MODE
        def keep_token(new_rt: str) -> None:
            try:
                save_token(new_rt)
            except OSError as e:
                log_cmd("token", f"X could not save refresh token: {e}")

        if refresh_token:
            client = TeslaClient(refresh_token, on_rotate=keep_token, cache="access_token")
        else:
            # No Owner API login: read through the Fleet API, which is billed.
            client = st.vc.client
            st.min_refresh      = FLEET_MIN_REFRESH
            st.refresh_interval = max(st.refresh_interval, FLEET_MIN_REFRESH)
        term.home(); term.clear_to_end()
        term.write("Authenticating…\n")
        cached = client.use_cached_token()
        if not cached:
            try:
                client.refresh_access_token()
            except RuntimeError:
                # An env token goes stale once Tesla rotates it; the saved one is newer.
                if not (env_token and saved_token and saved_token != env_token):
                    raise
                term.write("TESLA_REFRESH_TOKEN rejected, trying the saved token…\n")
                client.refresh_token = saved_token
                client.refresh_access_token()
        term.write("Looking up vehicle…\n")
        try:
            vid, vin = client.get_vehicle_id_and_vin(st.target_vin)
        except RuntimeError as e:
            if not (cached and str(e).startswith("HTTP 401")):
                raise
            client.refresh_access_token()      # the saved access token was revoked
            vid, vin = client.get_vehicle_id_and_vin(st.target_vin)
        st.vid   = vid

        dirty = threading.Event()           # new data or message: redraw
        def notify(msg: str) -> None:       # called from the background threads
            st.cmd_msg = f"h help    {c.YLW}{msg}{c.R}"
            dirty.set()
        st.notify = notify
        st.redraw = dirty.set

        if not st.target_vin and vin:
            st.target_vin = vin

        term.write(f"Connected: {st.target_vin or '?VIN?'} (vid {vid}) [{st.mode}]\n")
        if not vid:
            raise RuntimeError("No vehicle found -- check TESLA_VIN or token")

        data: Optional[Dict[str, Any]] = None
        poll = 3 if refresh_token else 10   # s between tries while waking (billed without)

        # The last data seen, kept so that a sleeping or unreachable car (an
        # underground car park) still shows its last known state.
        try:
            saved = json.loads(load_token(LAST_DATA_FILE) or "{}")
        except ValueError:
            saved = {}
        if jget(saved, "data.response.vin") == st.target_vin:
            data, st.data_at = saved["data"], float(saved.get("at") or 0)
        st.last_data = data

        def keep(new: Dict[str, Any]) -> Dict[str, Any]:
            st.data_at = time.time()
            try:
                save_token(json.dumps({"at": st.data_at, "data": new}), LAST_DATA_FILE)
            except OSError:
                pass
            return new

        # The car is asked for data in the background, so that keys always
        # answer at once; fetch_now makes it ask right away.
        fetch_now = threading.Event()
        wake = {"attempt": 0, "last": 0.0}

        def fetch(forced: bool) -> None:
            data = st.last_data
            if st.let_sleep:
                # Only the state is polled while the car is idle, so that it can
                # fall asleep; it is never woken up from here.
                try:
                    state = client.get_state(vid)
                except Exception:
                    state = "unreachable"           # no network, here or at the car
                new = None
                # Also right after a command or a destination: the car takes a
                # moment to show it.
                if state == "online" and (forced or data is None or car_busy(data)
                                          or time.time() < max(st.route_until, st.watch_until)):
                    try:
                        new = client.get_vehicle_data(vid, wants_location(st))
                    except Exception:
                        pass
                if new:
                    data = keep(new)
                elif data:
                    data["response"]["state"] = state
                else:
                    data = {"response": {"vin": st.target_vin, "state": state}}
            else:
                try:
                    new = client.get_vehicle_data(vid, wants_location(st))
                except Exception:
                    new = None
                if new:
                    wake["attempt"], st.status = 0, ""
                    data = keep(new)
                else:
                    # Asleep or out of reach: keep showing the last data and
                    # ask the car to wake up every WAKE_EVERY s.
                    if time.time() - wake["last"] >= WAKE_EVERY:
                        wake["attempt"] += 1
                        wake["last"] = time.time()
                        try:
                            try:
                                client.api_post(f"{client.api_base}/vehicles/{vid}/wake_up")
                            except RuntimeError:
                                client.refresh_access_token()   # it may have expired meanwhile
                                client.wake_up(vid)
                            st.status = f"Waking the car (attempt {wake['attempt']})…"
                        except Exception as e:
                            st.status = f"Car unreachable: {api_error(e)[:50]}"
                    if data is None:
                        data = {"response": {"vin": st.target_vin}}
                    data["response"]["state"] = "waking"
            st.last_data = data
            dirty.set()

        def fetch_loop() -> None:
            forced = True
            while True:
                try:
                    fetch(forced)
                except Exception:
                    pass
                forced = fetch_now.wait(poll if st.status else st.refresh_interval)
                fetch_now.clear()

        # Commands are sent one after the other in the background too.
        st.jobs = queue.Queue()
        def run_jobs() -> None:
            while True:
                job = st.jobs.get()
                try:
                    job()
                except Exception:
                    pass
                st.pending -= 1
                fetch_now.set()                     # show what the command did
                dirty.set()

        threading.Thread(target=fetch_loop, daemon=True).start()
        threading.Thread(target=run_jobs, daemon=True).start()

        size = term.get_size()
        while True:
            dirty.clear()
            data = st.last_data
            if st.show_help:
                render_help(term, c, st)
            elif data is None or "charge_state" not in data["response"]:    # no data seen yet
                term.home(); term.clear_to_end()
                state = (data or {}).get("response", {}).get("state")
                term.write((st.status or (f"Vehicle {state}, left to sleep" if state
                                          else "Asking the car…"))
                           + "  (w: wake it, W: keep it awake, q: quit)\n")
            else:
                render_dashboard(term, c, st, data)
            # Wait for a key, new data, a message to clear or a resize.
            while True:
                key = term.read_key_timeout(0.25)
                if (key is not None or dirty.is_set() or term.get_size() != size
                        or (st.cmd_msg_at and not st.pending
                            and time.time() - st.cmd_msg_at >= MSG_SECONDS)):
                    break
            size = term.get_size()
            if key is not None and handle_key(term, c, st, client, key):
                fetch_now.set()

    except KeyboardInterrupt:
        return 0
    except RuntimeError as e:
        err = str(e)
    finally:
        cleanup()

    # Only startup errors get here; the main loop retries on its own.
    print(f"tuisla: {err}", file=sys.stderr)
    if err.startswith(("HTTP 400", "HTTP 401", "Token refresh failed")):
        fix = "tuisla --login-tesla" if refresh_token else "tuisla --setup-vc (step 6)"
        print(f"tuisla: the refresh token looks invalid -- run: {fix}", file=sys.stderr)
    elif err.startswith("HTTP 403"):
        print("tuisla: Tesla refused the Owner API access token. Check that `curl -V` lists\n"
              "        HTTP2 (tuisla renews tokens over TLS 1.3 + HTTP/2 with curl); if it\n"
              "        does, Tesla may have closed the Owner API for this account.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
