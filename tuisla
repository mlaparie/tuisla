def log_file() -> str:
    """The command log, kept with the tokens (it may hold addresses)."""
    return token_path("tuisla.log")


def log_cmd(ep: str, result: str) -> None:
    ts    = _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    entry = f"{ts} - {ep} - {strip_ansi(result)}\n"
    try:
        os.makedirs(os.path.dirname(log_file()), mode=0o700, exist_ok=True)
        with open(log_file(), "a", encoding="utf-8") as f:
            f.write(entry)
    except OSError:
        pass


# =============================================================================
#  vc mode: commands signed with our own key by Tesla's tesla-http-proxy
#  (teslamotors/vehicle-command), using a Fleet API token from the user's own
#  developer app.  tuisla-setup-vc walks through all of it; the results live in
#  $XDG_STATE_HOME/tuisla/:
#    vc.json               client_id, domain, Fleet API base URL, VIN
#    fleet_refresh_token   Fleet API refresh token (rotated like refresh_token)
#    vc/private.pem        the key the car learns at pairing (never share it)
#    vc/public.pem         the same key's public half, hosted on the domain
#    vc/tls-*.pem          self-signed certificate for the local proxy
# =============================================================================

VC_CONFIG        = "vc.json"
FLEET_TOKEN_FILE = "fleet_refresh_token"
LAST_DATA_FILE   = "last_data.json"     # last vehicle data, shown while the car sleeps
FLEET_TOKEN_URL  = "https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token"
FLEET_REGIONS    = {"na": "https://fleet-api.prd.na.vn.cloud.tesla.com",
                    "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com"}
FLEET_MIN_REFRESH = 60     # s; Fleet API data costs money (500 requests/$1)


def vc_file(name: str) -> str:
    return token_path(os.path.join("vc", name))


def load_vc_config() -> Dict[str, Any]:
    text = load_token(VC_CONFIG)
    try:
        return json.loads(text) if text else {}
    except ValueError:
        die(f"{token_path(VC_CONFIG)} is not valid JSON; fix it or run: tuisla --setup-vc")
        return {}


def find_go_tool(name: str) -> str:
    gopath = os.environ.get("GOPATH") or os.path.expanduser("~/go")
    for cand in (shutil.which(name), os.path.join(gopath, "bin", name)):
        if cand and os.access(cand, os.X_OK):
            return cand
    return ""


def find_proxy() -> str:
    return find_go_tool("tesla-http-proxy")


# vc mode falls back to Bluetooth (tesla-control, from vehicle-command) when
# the internet route fails, e.g. in an underground car park.  REST commands
# and their tesla-control equivalents:
_BLE_SIMPLE = {
    "door_lock": "lock", "door_unlock": "unlock", "remote_start_drive": "drive",
    "auto_conditioning_start": "climate-on", "auto_conditioning_stop": "climate-off",
    "honk_horn": "honk", "flash_lights": "flash-lights", "wake_up": "wake",
    "charge_start": "charging-start", "charge_stop": "charging-stop",
    "charge_port_door_open": "charge-port-open", "charge_port_door_close": "charge-port-close",
    "open_tonneau": "tonneau-open", "close_tonneau": "tonneau-close", "stop_tonneau": "tonneau-stop",
    "media_toggle_playback": "media-toggle-playback", "media_next_track": "media-next-track",
    "media_prev_track": "media-previous-track", "media_next_fav": "media-next-favorite",
    "media_prev_fav": "media-previous-favorite", "media_volume_up": "media-volume-up",
    "media_volume_down": "media-volume-down", "cancel_software_update": "software-update-cancel",
}


def ble_args(ep: str, body: Optional[Dict[str, Any]]) -> List[str]:
    """tesla-control arguments for a command, or [] if it has none."""
    b = body or {}
    onoff = "on" if b.get("on") or b.get("enable") else "off"
    if ep in _BLE_SIMPLE:
        return [_BLE_SIMPLE[ep]]
    return {
        "actuate_trunk":     ["frunk-open" if b.get("which_trunk") == "front" else "trunk-open"],
        "window_control":    ["windows-vent" if b.get("command") == "vent" else "windows-close"],
        "set_sentry_mode":   ["sentry-mode", onoff],
        "guest_mode":        ["guest-mode-" + onoff],
        "set_charge_limit":  ["charging-set-limit", str(b.get("percent"))],
        "set_charging_amps": ["charging-set-amps", str(b.get("charging_amps"))],
        "set_temps":         ["climate-set-temp", f"{b.get('driver_temp')}c"],
        "adjust_volume":     ["media-set-volume", str(b.get("volume"))],
        "remote_steering_wheel_heater_request": ["steering-wheel-heater", onoff],
        "set_valet_mode":    ["valet-mode-on", str(b.get("password"))] if b.get("on") else ["valet-mode-off"],
    }.get(ep, [])


def ble_command(st: "State", ep: str, body: Optional[Dict[str, Any]]) -> Optional[Tuple[bool, str]]:
    """Send a command over Bluetooth; None if that is not possible."""
    tool, args = find_go_tool("tesla-control"), ble_args(ep, body)
    if not tool or not args or not os.path.exists(vc_file("private.pem")):
        return None
    if st.notify:
        st.notify("Network failed, trying Bluetooth…")
    try:
        out = subprocess.run([tool, "-ble", "-vin", st.target_vin, "-key-file", vc_file("private.pem"),
                              "-session-cache", vc_file("ble-session.json"), *args],
                             capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, f"Bluetooth: {e}"
    if out.returncode == 0:
        return True, ""
    if "CAP_NET_ADMIN" in out.stderr:
        return False, f"Bluetooth needs: sudo setcap cap_net_admin=eip {tool}"
    return False, "Bluetooth: " + ((out.stderr.strip().splitlines() or ["failed"])[-1])[:150]


def fleet_client(cfg: Dict[str, Any], refresh_token: str) -> TeslaClient:
    def keep(new_rt: str) -> None:
        try:
            save_token(new_rt, FLEET_TOKEN_FILE)
        except OSError as e:
            log_cmd("token", f"X could not save Fleet API refresh token: {e}")
    return TeslaClient(refresh_token, on_rotate=keep, api_base=cfg["fleet_api"] + "/api/1",
                       client_id=cfg["client_id"], token_url=FLEET_TOKEN_URL, scope="",
                       cache="fleet_access_token")


class VcBackend:
    """Sends vc-mode commands through tesla-http-proxy: one the user runs
    (VEHICLE_COMMAND_URL), or else one tuisla starts with the --setup-vc keys
    on a free local port and stops on exit."""

    def __init__(self, client: TeslaClient, url: str = "", cafile: str = "") -> None:
        self.client   = client
        self.external = bool(url)
        self.url      = url.rstrip("/")
        self.cafile   = cafile
        self.proc: Optional[subprocess.Popen] = None

    def context(self) -> ssl.SSLContext:
        ctx = ssl.create_default_context(cafile=self.cafile if os.path.exists(self.cafile) else None)
        # The proxy's self-signed certificate is its own CA; Python 3.13+ would
        # reject that under its strict checks.
        ctx.verify_flags &= ~getattr(ssl, "VERIFY_X509_STRICT", 0)
        return ctx

    def start(self) -> None:
        if self.external or (self.proc and self.proc.poll() is None):
            return
        binary = find_proxy()
        if not binary:
            raise RuntimeError("tesla-http-proxy not found (run: tuisla --setup-vc)")
        keys = [vc_file(n) for n in ("private.pem", "tls-key.pem", "tls-cert.pem")]
        for k in keys:
            if not os.path.exists(k):
                raise RuntimeError(f"{k} missing (run: tuisla --setup-vc)")
        with socket.socket() as sock:
            sock.bind(("127.0.0.1", 0))
            port = sock.getsockname()[1]
        with open(vc_file("proxy.log"), "ab") as log:
            self.proc = subprocess.Popen(
                [binary, "-key-file", keys[0], "-tls-key", keys[1], "-cert", keys[2],
                 "-host", "localhost", "-port", str(port)],
                stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
        self.url, self.cafile = f"https://localhost:{port}", keys[2]
        ctx = self.context()
        for _ in range(50):
            if self.proc.poll() is not None:
                break
            try:
                urllib.request.urlopen(self.url + "/health", context=ctx, timeout=2).close()
                return
            except Exception:
                time.sleep(0.2)
        self.stop()
        raise RuntimeError(f"tesla-http-proxy did not start; see {vc_file('proxy.log')}")

    def stop(self) -> None:
        if self.proc:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None

    def command(self, vin: str, ep: str, body: Optional[Dict[str, Any]]) -> Dict[str, Any]:
        self.start()
        url = f"{self.url}/api/1/vehicles/{vin}/command/{ep}"
        if not (self.client.access_token or self.client.use_cached_token()):
            self.client.refresh_access_token()
        try:
            return self.client.api_post(url, body, ctx=self.context())
        except RuntimeError as e:
            if not str(e).startswith(("HTTP 401", "HTTP 403")):
                raise
            # The access token expired since it was last used; renew once.
            self.client.refresh_access_token()
            return self.client.api_post(url, body, ctx=self.context())


# =============================================================================
#  Command execution
# =============================================================================

def api_error(e: Exception) -> str:
    """The readable part of an API error: "HTTP 400: {"error": ...}" -> the error."""
    head, _, body = str(e).partition(": ")
    try:
        err = json.loads(body)
        msg = err.get("error_description") or err.get("error") or ""
        if isinstance(msg, str) and msg:
            return f"{head}: {msg}" if head.startswith("HTTP") else msg
    except (ValueError, AttributeError):
        pass
    return str(e)


def wake_for_command(client: TeslaClient, st: "State") -> bool:
    """Wake a sleeping car so that it gets the command; it falls asleep again
    on its own afterwards.  Returns False if it stays asleep."""
    if jget(st.last_data or {}, "response.state", "online") == "online":
        return True
    failures = 0
    for i in range(20):
        if i % 5 == 0:
            client.wake_up(st.vid)
        if st.notify:
            st.notify(f"Waking the car for the command… {2 * i}s")
        try:
            if client.get_state(st.vid) == "online":
                st.last_data["response"]["state"] = "online"
                return True
            failures = 0
        except Exception:
            failures += 1
            if failures == 3:               # no network: waiting is pointless
                return False
        time.sleep(2)
    return False


def run_cmd(client: Optional[TeslaClient], st: "State", ep: str, label: str,
            body: Optional[Dict[str, Any]], c: Colors) -> str:
    """Send a command; in live mode it is queued and sent in the background,
    and the message line shows its result when it comes."""
    if st.jobs is None or client is None or st.mode == "ro":
        return send_cmd(client, st, ep, label, body, c)
    def job() -> None:
        st.cmd_msg, st.cmd_msg_at = send_cmd(client, st, ep, label, body, c), 0.0
        if ep.startswith("navigation_") and "✓" in st.cmd_msg:
            # The Owner API data has no route: ask for it once, when the car has it.
            def route() -> None:
                fetch_route(client, st)
                if st.redraw:
                    st.redraw()
            threading.Timer(ROUTE_DELAY, route).start()
    st.pending += 1
    st.jobs.put(job)
    return f"h help    {c.YLW}… {label}{c.R}"


def send_cmd(client: Optional[TeslaClient], st: "State", ep: str, label: str,
             body: Optional[Dict[str, Any]], c: Colors) -> str:
    def done(ok: bool, msg: str) -> str:
        log_cmd(ep, msg)
        return f"h help    {c.GRN if ok else c.RED}{msg}{c.R}"

    # Dry run in ro mode and in demo mode (no token): the command was parsed
    # and validated, but nothing is sent to the car.
    if st.mode == "ro" or client is None:
        return done(True, f"✓ {label} ({'demo only due to ro mode' if st.mode == 'ro' else 'demo: not sent'})")
    if not st.target_vin:
        return done(False, "X TESLA_VIN missing")
    vin = urllib.parse.quote(st.target_vin)
    # Over Bluetooth the car wakes up by itself, so vc mode goes on and lets
    # the internet route fail into the Bluetooth one.
    if ep != "wake_up" and not wake_for_command(client, st) and st.mode != "vc":
        return done(False, "X the car did not wake up")

    try:
        if st.mode == "mtm":
            if not st.myteslamate_token:
                return done(False, "X MyTeslaMate token missing (run: tuisla --login-mtm)")
            # MyTeslaMate mirrors the Fleet API and authenticates with its own
            # token; ours is never sent to them.
            url = f"{MTM_API}/vehicles/{vin}" + ("/wake_up" if ep == "wake_up" else f"/command/{ep}")
            try:
                resp = client.api_post(url, body, bearer=st.myteslamate_token)
            except RuntimeError as e:
                if not str(e).startswith(("HTTP 401", "HTTP 403")):
                    raise
                # Some MyTeslaMate tokens are only accepted as a URL parameter.
                resp = client.api_post(f"{url}?token={urllib.parse.quote(st.myteslamate_token)}",
                                       body, bearer="")
        else:
            if st.vc is None:
                return done(False, "X vc mode is not set up (run: tuisla --setup-vc)")
            try:
                resp = st.vc.command(vin, ep, body)
            except Exception as e:
                ble = ble_command(st, ep, body)
                if ble is None:
                    raise
                return done(ble[0], f"✓ {label} (Bluetooth)" if ble[0]
                            else f"X {ble[1]} (internet: {api_error(e)[:50]})")
    except Exception as e:
        return done(False, f"X {api_error(e)[:180]}")

    ok = bool(jget(resp, "response.result", False)
              or (ep == "wake_up" and jget(resp, "response.state", "")))
    reason = str(jget(resp, "response.reason", "") or jget(resp, "response.string", "")
                 or jget(resp, "error", "") or "failed")
    return done(ok, f"✓ {label}" if ok else f"X {reason}")


# =============================================================================
#  Interactive command prompt  (raw-mode, tab-complete, Esc to cancel)
#
#  Tab-completion uses CMD_KEYS (static key names, no <placeholders>).
#  Algorithm (bash-style):
#    1. Compute LCP of all keys that start with the current buffer.
#    2. If LCP extends the buffer -> fill to LCP, no candidate list yet.
#    3. If already at LCP (no progress) -> show candidates on line above.
#    4. Unique match at any point -> fill entire key + trailing space.
# =============================================================================

def prompt_command(term: Term, c: Colors, st: "State") -> Optional[str]:
    """Returns the typed string, or None if cancelled (Esc/idle timeout)."""
    term_w, term_h = term.get_size()
    lbl_w   = 9
    col_w   = 2 + lbl_w + 20
    content_w = min(col_w * 2 + 2, term_w)
    margin  = max(0, (term_w - min(content_w, term_w)) // 2)

    row = st.prompt_row
    col = st.prompt_col          # right after "h help" label

    buf: List[str] = []

    def erase_prompt() -> None:
        term.move(row, col)
        term.write("\x1b[K")     # erase to end of line

    def redraw() -> None:
        erase_prompt()
        term.write(f"{c.B}:{c.R} {''.join(buf)}")

    def erase_candidates() -> None:
        for r in (row + 1, row + 2, row + 3):
            term.move(r, margin)
            term.write("\x1b[K")

    term.cursor(True)
    redraw()

    import select as _sel

    while True:
        try:
            r, _, _ = _sel.select([sys.stdin], [], [], 120)
        except Exception:
            break
        if not r:
            break

        ch = read_key(pager=False)

        if ch == "\x1b":
            erase_prompt()
            erase_candidates()
            term.cursor(False)
            return None

        if ch in ("\r", "\n"):
            erase_prompt()
            erase_candidates()
            term.cursor(False)
            return "".join(buf).strip()

        if ch in ("\x7f", "\x08"):
            if buf:
                buf.pop()
                redraw()
            continue

        if ch == "\t":
            partial = "".join(buf)
            matches = [k for k in CMD_KEYS if k.startswith(partial)]

            if not matches:
                pass
            elif len(matches) == 1:
                buf = list(matches[0]) + [" "]
                erase_candidates()
                redraw()
            else:
                lcp = _longest_common_prefix(matches)
                if lcp != partial:
                    buf = list(lcp)
                    erase_candidates()
                    redraw()
                else:
                    # Collapse alias siblings, then wrap across up to 4 lines
                    displayed: List[str] = []
                    seen_alias: set = set()
                    for m in matches:
                        alias = next(
                            (d for d, (_, keys) in _PAGER_ALIASES.items() if m in keys),
                            None
                        )
                        if alias:
                            if alias not in seen_alias:
                                seen_alias.add(alias)
                                displayed.append(re.split(r"\s+<", alias)[0])
                        else:
                            displayed.append(m)
                    erase_candidates()
                    line_w = content_w - 2
                    out_lines: List[str] = [""]
                    for token in displayed:
                        tok = token + "  "
                        if len(out_lines[-1]) + len(tok) > line_w:
                            if len(out_lines) >= 4:
                                out_lines[-1] = out_lines[-1].rstrip() + "  (+ more)"
                                break
                            out_lines.append("")
                        out_lines[-1] += tok
                    for i, ln in enumerate(out_lines):
                        term.move(row + 2 + i, margin + 5)
                        term.write(f"{c.GRY}{ln.rstrip()}{c.R}")
                    redraw()
            continue

        if ch.isprintable():
            buf.append(ch)
            redraw()

    erase_prompt()
    erase_candidates()
    term.cursor(False)
    return None


def parse_and_run_cmd(term: Term, c: Colors, client: Optional[TeslaClient],
                      st: "State") -> str:
    """
    Prompt -> parse -> dispatch to run_cmd.
    Typing "help" opens the command pager (same as pressing ?).
    """
    raw = prompt_command(term, c, st)
    if raw is None or raw == "":
        return ""

    # "help" at the prompt -> open command pager inline
    if raw.strip().lower() == "help":
        show_cmd_pager(term, c)
        return ""

    tokens = raw.strip().split()

    # Find the longest matching static prefix key
    best_key: Optional[str]              = None
    best_ep:  Optional[str]              = None
    best_tpl: Optional[Dict[str, Any]]   = None
    best_args: List[str]                 = []
    best_len: int                        = -1

    for key, (ep, tpl, _help, arg_names) in _CMD_LOOKUP.items():
        key_tokens = key.split()
        n = len(key_tokens)
        if tokens[:n] == key_tokens and n > best_len:
            best_key  = key
            best_ep   = ep
            best_tpl  = tpl
            best_args = arg_names
            best_len  = n

    if best_key is None or best_ep is None:
        result = f"h help    {c.RED}Unknown command: {raw}{c.R}"
        log_cmd(raw, result)
        return result

    def fail(msg: str) -> str:
        log_cmd(best_ep or raw, f"X {msg}")
        return f"h help    {c.RED}X {msg}{c.R}"

    arg_tokens = tokens[best_len:]
    if best_ep == "_chargers" and arg_tokens:          # optional range, in km
        try:
            st.charger_range_km = float(arg_tokens[0])
        except ValueError:
            return fail(f"range must be a number of km, got '{arg_tokens[0]}'")
    if best_ep == "_mapscii_country":                    # optional country name
        st.map_country = " ".join(arg_tokens)
    if len(arg_tokens) < len(best_args):
        return fail(f"missing argument <{best_args[len(arg_tokens)]}> for '{best_key}'")
    if best_args and best_args[-1] in _TEXT_ARGS:     # free text: takes the rest of the line
        n = len(best_args) - 1
        arg_tokens = arg_tokens[:n] + [" ".join(arg_tokens[n:])]

    args: Dict[str, Any] = {}
    for name, raw_val in zip(best_args, arg_tokens):
        if name in ("pin", "password") or name in _TEXT_ARGS:   # keep leading zeros
            args[name] = raw_val
            continue
        try:
            args[name] = int(raw_val)
        except ValueError:
            try:
                args[name] = float(raw_val)
            except ValueError:
                args[name] = raw_val

    if "seat" in args:
        seat = _SEATS.get(str(args["seat"]).lower(), args["seat"])
        if not isinstance(seat, int):
            return fail(f"unknown seat '{args['seat']}' (driver, passenger, rl, rc, rr)")
        if best_ep != "remote_seat_heater_request":
            if seat not in (0, 1):
                return fail("only the front seats (driver, passenger) have this")
            seat += 1                        # these commands number the front seats 1 and 2
        args["seat"] = seat
    if best_ep == "remote_seat_cooler_request":
        if args["level"] not in (0, 1, 2, 3):
            return fail("seat cooling level must be 0-3")
        args["level"] += 1                   # the car counts 1 (off) to 4 (high)
    if best_ep == "set_cop_temp":
        if str(args["level"]).lower() not in _COP_TEMPS:
            return fail("level must be low, medium or high")
        args["level"] = _COP_TEMPS[str(args["level"]).lower()]
    if best_ep == "speed_limit_set_limit":
        if not isinstance(args["limit"], (int, float)):
            return fail(f"speed limit must be a number, got '{args['limit']}'")
        if st.unit == "metric":
            args["limit"] = round(args["limit"] / 1.609344, 1)

    body: Optional[Dict[str, Any]] = None
    if best_tpl is not None:
        body = {}
        for k, v in best_tpl.items():
            m = re.fullmatch(r"<(\w+)>", v) if isinstance(v, str) else None
            body[k] = args[m.group(1)] if m else v

    if best_ep == "set_temps" and body is not None:
        for k in ("driver_temp", "passenger_temp"):
            if body[k] is None:
                # set_temps needs both seats; keep the other one as it is now
                cur = jget(st.last_data or {}, f"response.climate_state.{k}_setting", None)
                if cur is None:
                    return fail(f"current {k.split('_')[0]} temp unknown -- use 'temp'")
                body[k] = float(cur)
            elif not isinstance(body[k], (int, float)):
                return fail(f"temperature must be a number, got '{body[k]}'")
            elif st.unit == "us" and best_tpl and best_tpl[k] is not None:
                body[k] = round((body[k] - 32) * 5 / 9, 1)

    if body is not None and best_ep in ("trigger_homelink", "window_control"):
        # Homelink (and closing windows on cars without the signed protocol)
        # must be sent from near the car, so send the car's own location.
        lat, lon = car_location(client if best_ep == "trigger_homelink" else None, st)
        if lat is None and best_ep == "trigger_homelink":
            return fail("car location unknown")
        if lat is not None:
            body["lat"], body["lon"] = lat, lon

    if best_ep == "navigation_gps_request" and not all(
            isinstance(args[k], (int, float)) for k in ("lat", "lon")):
        return fail("lat and lon must be numbers")
    if best_ep.startswith("navigation_"):
        st.route_until = time.time() + ROUTE_WATCH
    if best_ep == "navigation_request" and body is not None:
        body = {"type": "share_ext_content_raw", "locale": "en-US",
                "timestamp_ms": str(int(time.time() * 1000)),
                "value": {"android.intent.extra.TEXT": body["address"]}}

    label = best_key[0].upper() + best_key[1:]
    if best_ep.startswith("_"):
        return run_info_cmd(term, c, client, st, best_ep)
    return run_cmd(client, st, best_ep, label, body, c)


ROUTE_DELAY = 8                  # s for the car to compute a route sent to it
ROUTE_ENDPOINTS = ("charge_state;climate_state;closures_state;drive_state;gui_settings;"
                   "location_data;vehicle_config;vehicle_state")
ROUTE_DUMP_FILE = "route_debug.json"


def route_keys(obj: Any, path: str = "") -> List[str]:
    """Paths of the keys that look like a route, anywhere in the data."""
    found: List[str] = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            p = f"{path}.{k}" if path else k
            if re.search(r"route|dest|nav|arriv|trip|eta", k, re.I):
                found.append(p)
            found += route_keys(v, p)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            found += route_keys(v, f"{path}[{i}]")
    return found


def fetch_route(client: TeslaClient, st: "State") -> None:
    """The Owner API data has no route (active_route_*), so ask the Fleet API
    for it: through MyTeslaMate in mtm mode, through our own app in vc mode."""
    path = (f"/vehicles/{urllib.parse.quote(st.target_vin)}/vehicle_data?endpoints="
            + urllib.parse.quote(ROUTE_ENDPOINTS))
    try:
        if st.mode == "mtm" and st.myteslamate_token:
            try:
                resp = client._request("GET", MTM_API + path, None, None, st.myteslamate_token)
            except RuntimeError as e:
                if not str(e).startswith(("HTTP 401", "HTTP 403")):
                    raise
                resp = client._request("GET", f"{MTM_API}{path}&token="
                                       + urllib.parse.quote(st.myteslamate_token), None, None, "")
        elif st.mode == "vc" and st.vc is not None:
            resp = st.vc.client.api_get(path)
        else:
            return
    except Exception as e:
        log_cmd("route", f"X {api_error(e)[:150]}")
        return
    try:   # whole answer, to look for the route under another name
        dump = token_path(ROUTE_DUMP_FILE)
        os.makedirs(os.path.dirname(dump), mode=0o700, exist_ok=True)
        with open(os.open(dump, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(resp, f, indent=2, ensure_ascii=False)
    except Exception:
        pass
    log_cmd("route", "route-like keys: " + (", ".join(route_keys(resp)) or "none")
            + f" (whole answer in {token_path(ROUTE_DUMP_FILE)})")
    ds = jget(resp, "response.drive_state", {}) or {}
    st.route = {k: v for k, v in ds.items() if k.startswith("active_route_")} \
        if ds.get("active_route_destination") else {}
    log_cmd("route", f"✓ {st.route['active_route_destination']}" if st.route else
            "no route in the Fleet API data; drive_state has: " + (", ".join(sorted(ds)) or
                                                                   f"nothing ({str(resp)[:120]})"))


def route_fields(st: "State", data: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """active_route_* from the car's data, else from the last fetch_route."""
    ds = jget(data or st.last_data or {}, "response.drive_state", {}) or {}
    return ds if ds.get("active_route_destination") else st.route


def car_busy(data: Dict[str, Any]) -> bool:
    """Driving, charging, conditioning or someone inside: no sleep coming."""
    r = data.get("response") or {}
    return bool(jget(r, "drive_state.shift_state") in ("D", "R", "N")
                or str(jget(r, "charge_state.charging_state", "")).lower() == "charging"
                or jget(r, "climate_state.is_climate_on") or jget(r, "vehicle_state.is_user_present"))


def wants_location(st: "State") -> bool:
    """Ask for the location with the data while driving or following a route."""
    ds = jget(st.last_data or {}, "response.drive_state", {}) or {}
    return (time.time() < st.route_until or ds.get("shift_state") in ("D", "R", "N")
            or bool(route_fields(st)))


def car_location(client: Optional[TeslaClient], st: "State",
                 fresh: bool = False) -> Tuple[Optional[float], Optional[float]]:
    """The car's position from the last data, else asked for (with a client):
    routine refreshes leave the location out, since it makes them slower.
    The answer also brings the route (active_route_*)."""
    if client and st.last_data and (fresh or jget(st.last_data, "response.drive_state.latitude") is None):
        try:
            got = client.api_get(f"/vehicles/{st.vid}/vehicle_data?endpoints="
                                 + urllib.parse.quote("drive_state;location_data"))
            st.last_data["response"].setdefault("drive_state", {}).update(
                jget(got, "response.drive_state", {}) or {})
        except Exception:
            pass
    lat = jget(st.last_data or {}, "response.drive_state.latitude", None)
    lon = jget(st.last_data or {}, "response.drive_state.longitude", None)
    return (lat, lon) if lat is not None and lon is not None else (None, None)


def position_age(st: "State") -> str:
    """"position from 20 Feb" when the car's last GPS fix is over a day old
    (Tesla sometimes stops refreshing it), else ""."""
    t = jget(st.last_data or {}, "response.drive_state.gps_as_of", None)
    try:
        t = float(t)
    except (TypeError, ValueError):
        return ""
    if time.time() - t < 86400:
        return ""
    at = _dt.datetime.fromtimestamp(t)
    return "position from " + at.strftime("%-d %b" + (" %Y" if at.year != _dt.date.today().year else ""))


# Browsers that open a link in a new window unless told --new-tab; the others
# (Chromium and co, and anything xdg-open or macOS's open start) take a tab.
_NEW_TAB_BROWSERS = ("firefox", "librewolf", "icecat", "waterfox", "floorp", "zen",
                     "mullvad-browser", "seamonkey")


def browser_command(url: str) -> Tuple[Optional[List[str]], str]:
    """The default browser's command for url (Linux), from the Exec line of
    its .desktop file, in a new tab; None to leave it to xdg-open, with why."""
    try:
        desktop = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/https"],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, f"xdg-mime: {e}"
    if not desktop:
        return None, "xdg-mime knows no default browser (x-scheme-handler/https)"
    dirs = [os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")]
    dirs += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    for d in dirs:
        try:
            with open(os.path.join(d, "applications", desktop), encoding="utf-8") as f:
                exec_line = next((ln[5:].strip() for ln in f if ln.startswith("Exec=")), "")
        except (OSError, ValueError):
            continue
        try:
            argv = shlex.split(exec_line)
        except ValueError:
            return None, f"{desktop}: Exec={exec_line}"
        new_tab = ["--new-tab"] if any(b in a.lower() for a in argv for b in _NEW_TAB_BROWSERS) else []
        cmd, placed = [], False
        for a in argv:
            if re.fullmatch(r"%[uUfF]", a) and not placed:
                cmd += new_tab + [url]
                placed = True
            elif not re.fullmatch(r"%[a-zA-Z]", a):
                cmd.append(a)
        return (cmd if placed else cmd + new_tab + [url]), f"{desktop}: Exec={exec_line}"
    return None, f"{desktop} is in no applications folder of {':'.join(dirs)}"


def no_browser() -> str:
    """Why no browser opened: no display, or no xdg-utils."""
    if not sys.platform.startswith("linux") or shutil.which("termux-open-url"):
        return ""
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return " (no DISPLAY or WAYLAND_DISPLAY here)"
    return "" if shutil.which("xdg-open") else " (install xdg-utils)"


def open_url_quietly(url: str) -> str:
    """Open url in a new tab of a graphical browser without writing to the
    terminal (the webbrowser module may start a text browser inside the TUI
    instead): $BROWSER, else the default browser (xdg-utils).  Returns the
    command used, "" if none."""
    def start(cmd: List[str]) -> str:
        shown = " ".join(a if a != url else "<link>" for a in cmd)
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.PIPE, start_new_session=True)
        except OSError as e:
            log_cmd("browser", f"X {shown}: {e}")
            return ""

        def report() -> None:      # a browser that fails says so on stderr
            err = proc.stderr.read().decode("utf-8", "replace").strip() if proc.stderr else ""
            if proc.wait():
                log_cmd("browser", f"X {shown} exited with {proc.returncode}: {err[-300:] or 'no message'}")
        threading.Thread(target=report, daemon=True).start()
        return shown

    if shutil.which("termux-open-url"):
        return start(["termux-open-url", url])
    if sys.platform == "darwin":
        return start(["open", url])
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return ""
    for b in (os.environ.get("BROWSER") or "").split(":"):
        argv = shlex.split(b)
        if argv and shutil.which(argv[0]):
            args = [a.replace("%s", url) for a in argv]
            return start(args if "%s" in b else args + [url])
    if shutil.which("xdg-mime"):
        cmd, why = browser_command(url)
        if cmd and shutil.which(cmd[0]):
            return start(cmd)
        log_cmd("browser", f"default browser not used ({why}); trying xdg-open")
    if shutil.which("xdg-open"):
        return start(["xdg-open", url])
    return ""


# mapscii with start coordinates and markers is still a pull request
# (github.com/rastapasta/mapscii/pull/161), so unless a mapscii that has them
# is installed, that pull request is fetched at this commit and built once.
MAPSCII_REPO   = "https://github.com/rastapasta/mapscii.git"
MAPSCII_COMMIT = "0032cabbcab021de1710271277c51512c6242409"
ESBUILD        = "esbuild@0.28.2"


def with_node(cmd: List[str]) -> List[str]:
    """cmd as is if Node.js is installed, else run in a temporary guix shell
    or nix-shell, so that nothing gets installed."""
    if cmd[0] not in ("node", "npm", "npx") or shutil.which(cmd[0]):
        return cmd
    if shutil.which("guix"):
        return ["guix", "shell", "node", "--", *cmd]
    if shutil.which("nix-shell"):
        return ["nix-shell", "-p", "nodejs", "--run", shlex.join(cmd)]
    raise RuntimeError("mapscii needs Node.js 18+ (or Guix or Nix to provide it)")


def mapscii_command() -> List[str]:
    """How to run a mapscii that takes --lat/--lon/--marker, building it if
    needed (progress goes to the terminal).  Raises RuntimeError."""
    mapscii = shutil.which("mapscii")
    if mapscii:
        try:
            usage = subprocess.run([mapscii, "--help"], capture_output=True, text=True,
                                   stdin=subprocess.DEVNULL, timeout=20).stdout
        except (OSError, subprocess.TimeoutExpired):
            usage = ""
        if "--marker" in usage:
            return [mapscii]
    cache  = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                          "tuisla", f"mapscii-{MAPSCII_COMMIT[:8]}")
    bundle = os.path.join(cache, "dist", "mapscii.mjs")   # it finds ../styles from there
    if os.path.exists(bundle):
        patch_mapscii(bundle)
        return ["node", bundle]
    if not shutil.which("git"):
        raise RuntimeError("mapscii needs git to fetch mapscii")
    print(f"Fetching mapscii (pull request 161) into {cache}; only this once…", flush=True)
    steps = [["git", "init", "-q"],
             ["git", "fetch", "-q", "--depth", "1", MAPSCII_REPO, MAPSCII_COMMIT],
             ["git", "checkout", "-q", "FETCH_HEAD"],
             ["npm", "install", "-q", "--omit=dev", "--no-audit", "--no-fund"],
             # Its build needs bun; esbuild makes a bundle plain Node runs.
             ["npx", "-y", ESBUILD, "main.ts", "--bundle", "--platform=node", "--format=esm",
              "--target=node18", "--external:terminal-kit", "--log-level=error", "--outfile=build.mjs",
              '--banner:js=import{createRequire as __cr}from"module";const require=__cr(import.meta.url);']]
    os.makedirs(cache, exist_ok=True)
    for cmd in steps:
        if subprocess.run(with_node(cmd), cwd=cache).returncode != 0:
            raise RuntimeError(f"fetching mapscii failed at: {' '.join(cmd[:3])}")
    with open(os.path.join(cache, "build.mjs"), encoding="utf-8") as f:
        code = f.read()
    # terminal-kit is CommonJS, which Node cannot import by name.
    code = code.replace('import { terminal as term } from "terminal-kit";',
                        'import __tk from "terminal-kit"; const term = __tk.terminal;')
    os.makedirs(os.path.dirname(bundle), exist_ok=True)
    with open(bundle, "w", encoding="utf-8") as f:
        f.write(code)
    patch_mapscii(bundle)
    return ["node", bundle]


def patch_mapscii(bundle: str) -> None:
    """Small changes to the mapscii bundle: MAPSCII_GLOBE=1 opens the globe
    view once the map is up, as if o was pressed (mapscii has no option for
    it), and a space between each marker and its label."""
    with open(bundle, encoding="utf-8") as f:
        code = f.read()
    patched = code
    hook = "    if (this.locateOnStart) {"
    if "MAPSCII_GLOBE" not in patched and hook in patched:
        patched = patched.replace(hook, "    if (process.env.MAPSCII_GLOBE) setTimeout("
                                  "() => void this._handleGlobeView(), 300);\n" + hook, 1)
    patched = patched.replace("const labelX = x + glyphWidth * 2;",
                              "const labelX = x + (glyphWidth + 1) * 2;", 1)
    if patched != code:
        with open(bundle, "w", encoding="utf-8") as f:
            f.write(patched)


DEFAULT_RANGE_KM = 100            # chargers range when the car's range is unknown


def range_km(st: "State") -> float:
    """The chargers range: as set with r, else what the battery has left."""
    if st.charger_range_km:
        return st.charger_range_km
    mi = jget(st.last_data or {}, "response.charge_state.battery_range", None)
    return float(mi) * 1.609344 if mi else DEFAULT_RANGE_KM


def range_text(st: "State") -> str:
    km = range_km(st)
    return f"{km:.0f} KM" if st.unit == "metric" else f"{km / 1.609344:.0f} MI"


def nearby_chargers(client: Optional[TeslaClient], st: "State") -> Dict[str, Any]:
    """nearby_charging_sites within range_km, as {"superchargers": [...],
    "destination_charging": [...]}."""
    radius = range_km(st) / 1.609344                 # the API counts in miles
    if client is None:
        return demo_chargers(st, radius)
    path = f"/vehicles/{st.vid}/nearby_charging_sites"
    try:
        return client.api_get(f"{path}?radius={max(1, round(radius))}&count=100").get("response") or {}
    except RuntimeError as e:
        if not str(e).startswith("HTTP 400"):
            raise
        return client.api_get(path).get("response") or {}    # parameters refused


# Every Supercharger in the world, from supercharge.info's open data, for
# mapscii world and country: cached, and refreshed in the background once a week.
SUPERCHARGE_INFO = "https://supercharge.info/service/supercharge/allSites"
WORLD_REFRESH    = 7 * 86400


OVERPASS      = "https://overpass-api.de/api/interpreter"
DEMO_SITES    = 50               # chargers of each kind around the demo car
DEMO_OSM_KM   = 30               # how far the demo looks for other chargers


def km_between(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    a = (math.sin(math.radians(lat2 - lat1) / 2) ** 2 + math.cos(math.radians(lat1))
         * math.cos(math.radians(lat2)) * math.sin(math.radians(lon2 - lon1) / 2) ** 2)
    return 12742 * math.asin(math.sqrt(a))


def demo_chargers(st: "State", radius_mi: float) -> Dict[str, Any]:
    """What nearby_charging_sites would say around the demo car, from open
    data: Superchargers from supercharge.info, other fast chargers from
    OpenStreetMap.  No free stalls: those are live, from Tesla only."""
    ds = DEMO_DATA["response"]["drive_state"]
    lat, lon = ds["latitude"], ds["longitude"]

    def site(name: str, la: float, lo: float, **extra: Any) -> Dict[str, Any]:
        return {"name": name, "distance_miles": round(km_between(lat, lon, la, lo) / 1.609344, 1),
                "location": {"lat": la, "long": lo}, **extra}

    sc = [site(x["name"], x["gps"]["latitude"], x["gps"]["longitude"], total_stalls=x.get("stallCount"))
          for x in world_superchargers(st.notify)]
    sc = sorted((x for x in sc if x["distance_miles"] <= radius_mi), key=lambda x: x["distance_miles"])
    others: List[Dict[str, Any]] = []
    km = min(DEMO_OSM_KM, radius_mi * 1.609344)
    query = (f'[out:json][timeout:80];nwr["amenity"="charging_station"]["socket:type2_combo"]'
             f'(around:{int(km * 1000)},{lat},{lon});out center tags;')
    path, elements = cache_file("demo_chargers.json"), None
    try:                                # the demo car stays put: asked once a week
        with open(path, encoding="utf-8") as f:
            cached = json.load(f)
        if cached.get("query") == query and time.time() - os.path.getmtime(path) < WORLD_REFRESH:
            elements = cached["elements"]
    except (OSError, ValueError, KeyError):
        pass
    if elements is None:
        st.notify("Looking for other chargers around the demo car in OpenStreetMap…")
        try:
            req = urllib.request.Request(OVERPASS, urllib.parse.urlencode({"data": query}).encode(),
                                         headers={"User-Agent": "tuisla"})
            with urllib.request.urlopen(req, timeout=90) as r:
                elements = json.load(r).get("elements") or []
            with open(path, "w", encoding="utf-8") as f:
                json.dump({"query": query, "elements": elements}, f)
        except (OSError, ValueError) as e:
            st.notify(f"No other chargers: OpenStreetMap: {e}")
            elements = []
    for x in elements:
        t, c = x.get("tags") or {}, x.get("center") or x
        op = (t.get("network") or t.get("brand") or t.get("operator") or "").split(";")[0].strip()
        name = t.get("name") or ""
        if "tesla" in f"{op} {name}".lower() or c.get("lat") is None or not (op or name):
            continue
        if op and name.lower().startswith(op.lower()):
            name = name[len(op):].strip(" -|:")
        label = f"{op} - {name}" if op and name else (op or name)
        others.append(site(label, c["lat"], c["lon"]))
    others.sort(key=lambda x: x["distance_miles"])
    kept: List[Dict[str, Any]] = []
    for x in others:                    # spread out, like Tesla's list (OSM maps each charger)
        if not any(km_between(x["location"]["lat"], x["location"]["long"],
                              k["location"]["lat"], k["location"]["long"]) < 1.5 for k in kept):
            kept.append(x)
    return {"superchargers": sc[:DEMO_SITES], "destination_charging": kept[:DEMO_SITES]}


def world_superchargers(notify: Optional[Callable[[str], None]]) -> List[Dict[str, Any]]:
    """The open Superchargers in supercharge.info's list."""
    path = cache_file("superchargers.json")

    def fetch() -> None:
        tmp = f"{path}.{os.getpid()}.{threading.get_ident()}.part"
        req = urllib.request.Request(SUPERCHARGE_INFO, headers={"User-Agent": "tuisla"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
                shutil.copyfileobj(r, f)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)

    if not os.path.exists(path):
        if notify:
            notify("Fetching the world's Superchargers from supercharge.info (once)…")
        fetch()
    elif time.time() - os.path.getmtime(path) > WORLD_REFRESH:
        def refresh() -> None:          # quietly: it would write over the TUI
            try:
                fetch()
            except Exception:
                pass
        threading.Thread(target=refresh, daemon=True).start()
    with open(path, encoding="utf-8") as f:
        sites = json.load(f)
    return [s for s in sites if s.get("status") == "OPEN" and s.get("gps")]


def site_point(site: Dict[str, Any]) -> Tuple[str, float, float, str]:
    return ("world", float(site["gps"]["latitude"]), float(site["gps"]["longitude"]), "")


def core(points: List[Tuple[str, float, float, str]]) -> List[Tuple[str, float, float, str]]:
    """The points without the farthest 2% on each side, so that overseas
    sites do not zoom a country out to half the world."""
    if len(points) < 20:
        return points
    def bounds(i: int) -> Tuple[float, float]:
        v = sorted(p[i] for p in points)
        return v[len(v) // 50], v[-1 - len(v) // 50]
    (la0, la1), (lo0, lo1) = bounds(1), bounds(2)
    return [p for p in points if la0 <= p[1] <= la1 and lo0 <= p[2] <= lo1]


def charger_points(sites: Dict[str, Any]) -> List[Tuple[str, float, float, str]]:
    """(kind, lat, lon, name) of each site that has a location."""
    out = []
    for kind in ("superchargers", "destination_charging"):
        for site in sites.get(kind) or []:
            loc = site.get("location") or {}
            if loc.get("lat") is not None and loc.get("long") is not None:
                out.append((kind, float(loc["lat"]), float(loc["long"]), str(site.get("name", "?"))))
    return out


def charger_infos(sites: Dict[str, Any], st: "State") -> List[str]:
    """For each site of charger_points, in the same order: its distance, and
    its free stalls for a Supercharger ("7/12 stalls free")."""
    out = []
    for kind in ("superchargers", "destination_charging"):
        for site in sites.get(kind) or []:
            loc = site.get("location") or {}
            if loc.get("lat") is None or loc.get("long") is None:
                continue
            d = float(site.get("distance_miles") or 0)
            parts = [(f"{d * 1.60934:.1f} km" if st.unit == "metric" else f"{d:.1f} mi") + " straight-line"]
            if site.get("site_closed"):
                parts.append("closed")
            elif site.get("available_stalls") is not None:
                parts.append(f"{int(site['available_stalls'])}/{site.get('total_stalls')} stalls free")
            elif site.get("total_stalls") is not None:
                parts.append(f"{site['total_stalls']} stalls")
            out.append(", ".join(parts))
    return out


def cache_file(name: str) -> str:
    d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "tuisla")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, name)


