_MARKERS = {"car": ("◯", "#ff3030"), "superchargers": ("■", "#00cc44"),
            "destination_charging": ("▮", "#00ccff"), "world": ("•", "#00cc44")}


def fit_zoom(points: List[Tuple[str, float, float, str]], cols: int, rows: int) -> Tuple[float, float, float]:
    """Center and mapscii zoom that show all the points (with room for labels).
    mapscii draws the world 256 * 2**zoom braille dots wide, 2x4 per cell."""
    lats = [p[1] for p in points]
    lons = [p[2] for p in points]
    def merc(lat: float) -> float:   # Web Mercator y, 0..1 for the whole world
        lat = max(-85.0, min(85.0, lat))
        return (1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2
    dx = max(max(lons) - min(lons), 1e-4) / 360
    dy = max(abs(merc(max(lats)) - merc(min(lats))), 1e-4)
    zoom = min(math.log2(cols * 2 * 0.6 / (256 * dx)),       # labels need room on the right
               math.log2((rows - 2) * 4 * 0.8 / (256 * dy)))
    return ((max(lats) + min(lats)) / 2, (max(lons) + min(lons)) / 2, max(1.0, min(16.0, round(zoom, 1))))


def run_mapscii(term: Term, c: Colors, points: List[Tuple[str, float, float, str]],
                zoom: Optional[float], fit: Optional[List[Tuple[str, float, float, str]]] = None,
                globe: bool = False) -> str:
    """Show the points in mapscii, in place of the dashboard until it quits:
    around the first one at that zoom, or all of them if zoom is None.  It
    draws on tuisla's screen, which is cleared afterwards, so no map is left
    in the terminal."""
    lat, lon = points[0][1], points[0][2]
    if zoom is None:
        lat, lon, zoom = fit_zoom(fit or points, *term.get_size())
    path = cache_file("markers.geojson")
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"type": "FeatureCollection", "features": [
            {"type": "Feature", "geometry": {"type": "Point", "coordinates": [plon, plat]},
             "properties": {"label": name, "glyph": _MARKERS[kind][0], "color": _MARKERS[kind][1]}}
            for kind, plat, plon, name in sorted(points, key=lambda p: p[0] == "car")]}, f)   # car on top
    term.disable_raw(); term.invert_screen(False); term.home(); term.clear_to_end(); term.cursor(True)
    try:
        subprocess.run(with_node(mapscii_command() + ["--lat", str(lat), "--lon", str(lon),
                                                      "--zoom", str(zoom), "--geojson", path]),
                       env={**os.environ, "MAPSCII_GLOBE": "1"} if globe else None)
    except (OSError, RuntimeError) as e:
        return f"h help    {c.RED}X {str(e)[:180]}{c.R}"
    finally:
        term.write("\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[0m")   # mapscii's mouse modes off
        term.home(); term.clear_to_end()
        term.cursor(False); term.invert_screen(c.inverted); term.enable_raw()
    return ""


def route_summary(st: "State") -> str:
    """'Monterey, CA, 115 km, 15:42 (+6 min traffic), 41% left' from the last data."""
    ds   = route_fields(st)
    dest = ds.get("active_route_destination")
    if not dest:
        return ""
    parts = [str(dest)]
    if ds.get("active_route_miles_to_arrival") is not None:
        mi = float(ds["active_route_miles_to_arrival"])
        parts.append(f"{miles_to_km(mi)} km" if st.unit == "metric" else f"{mi:.0f} mi")
    if ds.get("active_route_minutes_to_arrival") is not None:
        at    = _dt.datetime.now() + _dt.timedelta(minutes=float(ds["active_route_minutes_to_arrival"]))
        delay = int(float(ds.get("active_route_traffic_minutes_delay") or 0))
        parts.append(at.strftime("%H:%M") + (f" (+{delay} min traffic)" if delay else ""))
    if ds.get("active_route_energy_at_arrival") is not None:
        parts.append(f"{int(float(ds['active_route_energy_at_arrival']))}% left")
    return ", ".join(parts)


def run_info_cmd(term: Term, c: Colors, client: Optional[TeslaClient],
                 st: "State", ep: str) -> str:
    """Commands that only show something (chargers can also send one to the car)."""
    msg = _run_info_cmd(term, c, client, st, ep)
    old = position_age(st) if ep != "_mapscii_world" else ""
    if not old:
        return msg
    if not msg:                         # back from mapscii or the chargers list
        return f"h help    {c.YLW}Car {old}{c.R}"
    return f"{msg}  {c.YLW}({old}){c.R}" if "✓" in msg else msg


def _run_info_cmd(term: Term, c: Colors, client: Optional[TeslaClient],
                  st: "State", ep: str) -> str:
    def fail(msg: str) -> str:
        return f"h help    {c.RED}X {msg[:180]}{c.R}"

    if ep == "_route":
        car_location(client, st, fresh=True)
        if client is not None:
            fetch_route(client, st)
        st.route_until = time.time() + ROUTE_WATCH
        route = route_summary(st)
        if route:
            return f"h help    {c.GRN}✓ Route: {route}{c.R}"
        return f"h help    {c.GRY}No active route{c.R}"

    lat, lon = car_location(client, st)
    car = ("car", lat, lon, str(jget(st.last_data or {}, "response.vehicle_state.vehicle_name", "") or "car"))
    if ep == "_mapscii":
        return run_mapscii(term, c, [car], 15) if lat is not None else fail("car location unknown")
    if ep == "_map":
        if lat is None:
            return fail("car location unknown")
        url = f"https://www.openstreetmap.org/?mlat={lat}&mlon={lon}#map=17/{lat}/{lon}"
        opener = open_url_quietly(url)
        log_cmd("map", f"{opener or 'no browser'}: {url}")
        how = "" if opener else f" -- link in the log (z){no_browser()}"
        return f"h help    {c.GRN}✓ Map: {lat:.5f}, {lon:.5f}{how}{c.R}"

    if ep in ("_mapscii_world", "_mapscii_country"):
        try:
            sites = world_superchargers(st.notify)
        except (OSError, ValueError) as e:
            return fail(f"supercharge.info: {e}")
        mine = [car] if lat is not None else []
        if ep == "_mapscii_world":
            return run_mapscii(term, c, mine + [site_point(x) for x in sites], 0, globe=True)
        country = st.map_country
        if not country:                     # the car's: that of the nearest Supercharger
            if lat is None:
                return fail("car location unknown; name a country (mapscii country France)")
            country = min(sites, key=lambda x: (x["gps"]["latitude"] - lat) ** 2
                          + ((x["gps"]["longitude"] - lon) * math.cos(math.radians(lat))) ** 2
                          )["address"].get("country", "")
        names = sorted({x["address"].get("country", "") for x in sites})
        match = next((n for n in names if n.lower() == country.lower()), None) \
            or next((n for n in names if n.lower().startswith(country.lower())), None)
        if not match:
            return fail(f"no Superchargers listed for '{country}'")
        points = [site_point(x) for x in sites if x["address"].get("country") == match]
        return run_mapscii(term, c, mine + points, None, fit=core(points))

    try:
        sites = nearby_chargers(client, st)
    except Exception as e:
        return fail(api_error(e))
    if ep == "_chargers":
        site = show_chargers_pager(term, c, st, sites)
        if site is None:
            return ""
        st.route_until = time.time() + ROUTE_WATCH
        if client is None:
            demo_route(site)
        name, loc = str(site.get("name", "?")), site.get("location") or {}
        if loc.get("lat") is not None and loc.get("long") is not None:
            return run_cmd(client, st, "navigation_gps_request", f"Navigating to {name}",
                           {"lat": loc["lat"], "lon": loc["long"], "order": 1}, c)
        # No coordinates in what Tesla sent: search the name as a destination.
        log_cmd("chargers", f"no location for {name}; site has: {', '.join(sorted(site))}")
        text = name if "total_stalls" not in site else f"Tesla Supercharger {name}"
        return run_cmd(client, st, "navigation_request", f"Navigating to {name}",
                       {"type": "share_ext_content_raw", "locale": "en-US",
                        "timestamp_ms": str(int(time.time() * 1000)),
                        "value": {"android.intent.extra.TEXT": text}}, c)

    points = charger_points(sites)
    if lat is not None:
        points.insert(0, car)
    if not points:
        return fail("no locations to show")
    if ep == "_mapscii_chargers":
        return run_mapscii(term, c, points, None)
    fd, path = tempfile.mkstemp(prefix="tuisla-map-", suffix=".html")   # private, in /tmp
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(_MAP_HTML.replace("__POINTS__", json.dumps(
            [[*p, info] for p, info in zip(points, ([""] if lat is not None else [])
                                           + charger_infos(sites, st))]).replace("</", "<\\/")))
    opener = open_url_quietly("file://" + path)
    log_cmd("map chargers", f"{opener or 'no browser'}: {path}")
    how = "" if opener else f" -- open {path}{no_browser()}"
    return f"h help    {c.GRN}✓ Map: car and {len(points) - (lat is not None)} chargers{how}{c.R}"


