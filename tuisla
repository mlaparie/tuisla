# Set of keys that are secondary in an alias group (suppressed in pager/hints)
_PAGER_ALIAS_SECONDARY: set = {
    k for _, keys in _PAGER_ALIASES.values() for k in keys[1:]
}


def _build_pager_lines(c: Colors) -> List[str]:
    """Return ANSI-coloured lines for the command pager, grouped by _PAGER_CATS order."""
    reg: Dict[str, Tuple[str, str]] = {}
    for name, ep, _body, helptext in CMD_REGISTRY:
        key = re.split(r"\s+<", name)[0]
        reg[key] = (name, helptext)

    lines: List[str] = []
    lines.append(
        f"  {c.B}{c.MAG}COMMANDS {c.R}  "
        f"{c.GRY}?/q/Esc close  j/k/↓/↑ scroll  d/u/PgDn/PgUp half-page  g/G top/bottom  /search  n/N match{c.R}"
    )
    lines.append("")

    rendered: set = set()

    for cat_label, _ in _PAGER_CATS:
        cat_keys = [
            re.split(r"\s+<", name)[0]
            for name, ep, _, _ in CMD_REGISTRY
            if _pager_cat(ep) == cat_label
        ]
        if not cat_keys:
            continue

        lines.append("")
        lines.append(f"  {c.B}{c.MAG}{cat_label}{c.R}")

        for key in cat_keys:
            if key in rendered:
                continue
            alias = next(
                (disp for disp, (_, keys) in _PAGER_ALIASES.items() if keys[0] == key),
                None
            )
            if alias:
                parts       = re.split(r"(\s+<[^>]+>)", alias)
                cmd_vis     = parts[0]
                arg_hint    = "".join(parts[1:])
                merged_help = _PAGER_ALIASES[alias][0]
                lines.append(f"  {c.CYN}{cmd_vis}{c.R}{c.GRY}{arg_hint}{c.R}   {c.GRY}{merged_help}{c.R}")
                for k in _PAGER_ALIASES[alias][1]:
                    rendered.add(k)
            elif key in _PAGER_ALIAS_SECONDARY:
                rendered.add(key)
            else:
                name, helptext = reg[key]
                parts    = re.split(r"(\s+<[^>]+>)", name)
                cmd_vis  = parts[0]
                arg_hint = "".join(parts[1:])
                lines.append(f"  {c.CYN}{cmd_vis}{c.R}{c.GRY}{arg_hint}{c.R}   {c.GRY}{helptext}{c.R}")
                rendered.add(key)

    lines.append("")
    return lines


def show_cmd_pager(term: Term, c: Colors) -> None:
    """Open the command pager."""
    _pager_builtin(term, c, _build_pager_lines(c), title="COMMANDS")


def _pager_input(term: Term, c: Colors, prompt: str) -> str:
    """Read a line at the bottom of the screen; Esc gives ""."""
    import select as _sel
    _, term_h = term.get_size()
    row = term_h - 1
    buf: List[str] = []

    def redraw() -> None:
        term.move(row, 0)
        term.clear_line()
        term.write(f"{c.B}{prompt}{c.R}{''.join(buf)}")

    term.cursor(True)
    redraw()
    while True:
        try:
            r, _, _ = _sel.select([sys.stdin], [], [], 60)
        except Exception:
            break
        if not r:
            break
        ch = read_key(pager=False)
        if ch in ("\r", "\n"):
            break
        if ch == "\x1b":
            buf = []
            break
        if ch in ("\x7f", "\x08"):
            if buf:
                buf.pop()
                redraw()
            continue
        if ch.isprintable():
            buf.append(ch)
            redraw()
    term.cursor(False)
    term.move(row, 0)
    term.clear_line()
    return "".join(buf).strip()


def _pager_search_prompt(term: Term, c: Colors,
                         plain_lines: List[str]) -> Tuple[str, List[int]]:
    """Show/prompt at the bottom; return (pattern, matching_row_indices)."""
    pat = _pager_input(term, c, "/")
    if not pat:
        return ("", [])
    try:
        rx = re.compile(pat, re.IGNORECASE)
    except re.error:
        rx = re.compile(re.escape(pat), re.IGNORECASE)
    return (pat, [i for i, ln in enumerate(plain_lines) if rx.search(ln)])


def _pager_builtin(term: Term, c: Colors, all_lines: List[str], title: str = "",
                   picks: Optional[List[int]] = None, keys: str = "", hints: str = "") -> Any:
    """Built-in scrollable + searchable pager. Accepts pre-built line list.
    With picks (line numbers), j/k move a cursor over those lines and Enter
    returns the chosen line number.  Pressing one of keys returns that key."""
    import select as _sel

    plain_lines = [strip_ansi(ln) for ln in all_lines]

    scroll_top = 0
    search_pat = ""
    match_rows: List[int] = []
    match_idx  = 0
    pick       = 0
    chosen: Any = None

    def clamp(n: int) -> int:
        _, term_h = term.get_size()
        visible = max(1, term_h - 2)
        return max(0, min(n, max(0, len(all_lines) - visible)))

    def jump_to(idx: int) -> None:
        nonlocal scroll_top, match_idx
        if not match_rows:
            return
        match_idx  = idx % len(match_rows)
        scroll_top = clamp(match_rows[match_idx])

    def draw() -> None:
        _, term_h = term.get_size()
        visible = max(1, term_h - 2)
        term.home()
        term.clear_to_end()

        cur_match_row = match_rows[match_idx % len(match_rows)] if match_rows else -1

        for i in range(visible):
            idx = scroll_top + i
            if idx >= len(all_lines):
                term.write("\n")
                continue
            line = all_lines[idx]
            if picks and idx == picks[pick]:
                line = f"{c.REV}{strip_ansi(line)}{c.R}"
            elif search_pat and idx == cur_match_row:
                line = f"{c.YLW}{c.B}{strip_ansi(line)}{c.R}"
            elif search_pat:
                try:
                    rx   = re.compile(f"({re.escape(search_pat)})", re.IGNORECASE)
                    line = rx.sub(f"{c.REV}\\1{c.R}", line)
                except re.error:
                    pass
            term.write(line + c.R + "\n")

        term.move(term_h - 2, 0)
        term.clear_line()
        total   = len(all_lines)
        pct     = min(100, int(100 * (scroll_top + visible) / max(1, total)))
        minfo   = f"  [{match_idx % len(match_rows) + 1}/{len(match_rows)}]" if match_rows else ""
        patinfo = f"  /{search_pat}" if search_pat else ""
        bar_title = title or "pager"
        term.write(
            f"{c.REV} {bar_title}  {pct}%{patinfo}{minfo}"
            f"  j/k/↓/↑ d/u g/G  /search  n/N  {'Enter navigate  ' if picks else ''}{hints}q close {c.R}"
        )
        term.move(term_h - 1, 0)
        term.clear_line()

    draw()

    while True:
        try:
            r, _, _ = _sel.select([sys.stdin], [], [], 60)
        except Exception:
            break
        if not r:
            continue

        ch = read_key()
        _, term_h = term.get_size()
        half = max(1, (term_h - 2) // 2)

        if ch in ("q", "\x1b", "?", "z"):
            break
        elif picks and ch in ("\r", "\n"):
            chosen = picks[pick]
            break
        elif ch in keys:
            chosen = ch
            break
        elif picks and ch in ("j", "k"):
            pick = max(0, min(len(picks) - 1, pick + (1 if ch == "j" else -1)))
            visible = max(1, term_h - 2)
            if not scroll_top <= picks[pick] < scroll_top + visible:
                scroll_top = clamp(picks[pick] - (0 if ch == "k" else visible - 1))
        elif ch == "j":
            scroll_top = clamp(scroll_top + 1)
        elif ch == "k":
            scroll_top = clamp(scroll_top - 1)
        elif ch == "d":
            scroll_top = clamp(scroll_top + half)
        elif ch == "u":
            scroll_top = clamp(scroll_top - half)
        elif ch == "g":
            scroll_top = 0
        elif ch == "G":
            scroll_top = clamp(len(all_lines))
        elif ch == "n" and match_rows:
            jump_to(match_idx + 1)
        elif ch == "N" and match_rows:
            jump_to(match_idx - 1)
        elif ch == "/":
            search_pat, match_rows = _pager_search_prompt(term, c, plain_lines)
            match_idx = 0
            if match_rows:
                jump_to(0)
        else:
            continue

        draw()

    term.home()
    term.clear_to_end()
    return chosen


LOG_ROWS = 8                      # most rows an entry takes in the log pager (z)


def show_log_pager(term: Term, c: Colors) -> None:
    """Read tuisla.log and display it newest-first in the builtin pager."""
    try:
        with open(log_file(), "r", encoding="utf-8", errors="replace") as f:
            raw_lines = f.readlines()
    except OSError:
        raw_lines = []

    entries = [ln.rstrip() for ln in reversed(raw_lines) if ln.strip()]

    all_lines: List[str] = [
        f"  {c.B}{c.MAG}COMMAND LOG{c.R}  "
        f"{c.GRY}newest first  z/q/Esc close  j/k/↓/↑ scroll  d/u/PgDn/PgUp half-page  g/G top/bottom{c.R}",
        "",
    ]

    if not entries:
        all_lines.append(f"  {c.GRY}(log is empty){c.R}")
    else:
        width = max(20, term.get_size()[0] - 4)   # wrapped here: a row the terminal wraps throws the pager off
        for entry in entries:
            if " - ok" in entry or "✓" in entry:
                color = c.GRN
            elif any(x in entry for x in (" - X ", "Unknown", "missing", "disabled", "failed")):
                color = c.RED
            else:
                color = c.GRY
            rows = [entry[i:i + width] for i in range(0, len(entry), width)]
            if len(rows) > LOG_ROWS:
                rows = rows[:LOG_ROWS - 1] + [rows[LOG_ROWS - 1][:width - 1] + "…"]
            all_lines += [f"  {color}{r}{c.R}" for r in rows]

    all_lines.append("")
    _pager_builtin(term, c, all_lines, title=f"Command log  {len(entries)} entries")


def show_chargers_pager(term: Term, c: Colors, st: "State",
                        sites: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    """Nearby charging sites (from nearby_charging_sites) in the builtin pager;
    returns the one picked with Enter."""
    dist_u = "km" if st.unit == "metric" else "mi"

    def dist(site: Dict[str, Any]) -> str:
        d = float(site.get("distance_miles") or 0)
        return f"{d * 1.60934 if st.unit == 'metric' else d:6.1f} {dist_u}"

    all_lines: List[str] = [
        f"  {c.B}{c.MAG}CHARGERS WITHIN {range_text(st)} (STRAIGHT LINE){c.R}  "
        + (f"{c.YLW}{position_age(st)}{c.R}  " if position_age(st) else "")
        + f"{c.GRY}j/k/↓/↑ select  Enter send to car  q close{c.R}", ""]
    picked: Dict[int, Dict[str, Any]] = {}
    for title, key in (("Superchargers", "superchargers"), ("Destination", "destination_charging")):
        all_lines += ["", f"  {c.B}{c.MAG}{title}{c.R}"]
        for site in sites.get(key) or []:
            stalls = ""
            if site.get("total_stalls") is not None and site.get("available_stalls") is None:
                stalls = f"  {c.GRY}{site['total_stalls']} stalls{c.R}"     # demo data
            elif "total_stalls" in site:
                free   = int(site.get("available_stalls") or 0)
                col    = c.GRN if free else c.RED
                stalls = f"  {col}{free}/{site.get('total_stalls')} free{c.R}"
                if site.get("site_closed"):
                    stalls = f"  {c.RED}closed{c.R}"
            picked[len(all_lines)] = site
            all_lines.append(f"  {c.GRY}{dist(site)}{c.R}  {c.CYN}{site.get('name', '?')}{c.R}{stalls}")
        if not sites.get(key):
            all_lines.append(f"  {c.GRY}(none){c.R}")
    all_lines.append("")
    row = _pager_builtin(term, c, all_lines, title="Nearby chargers", picks=list(picked) or None)
    return picked.get(row)


