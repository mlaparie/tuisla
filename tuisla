def make_bat_bar(c: Colors, pct: int, width: int = 12) -> str:
    pct    = clamp_int(int(pct), 0, 100)
    filled = (pct * width) // 100
    empty  = width - filled
    col    = c.GRN if pct >= 70 else (c.YLW if pct >= 30 else c.RED)
    blocks = ("\u2588" * filled) + (f"{c.GRY}" + ("\u2591" * empty) if empty else "")
    return f"{col}{blocks}{col}{c.R} {col}{pct}%{c.R}"


def fmt_time_hhmm(minutes: int) -> str:
    minutes = max(0, int(minutes))
    return f"{minutes//60:02d}:{minutes%60:02d}"


def miles_to_km(mi: float) -> int:
    return int(round(mi * 1.60934))


def c_to_f(c: float) -> int:
    return int(round((c * 9.0 / 5.0) + 32.0))


def bar_to_psi(bar: float) -> int:
    return int(round(bar * 14.5037738))


# =============================================================================
#  Key handling
# =============================================================================

def handle_key(term: Term, c: Colors, st: State, client: Optional[TeslaClient],
               vid: str, key: Optional[str]) -> bool:
    """Returns True if the caller should fetch fresh vehicle data."""
    if key is None:
        return True                         # timeout -> refresh

    if key in ("q", "Q"):
        raise KeyboardInterrupt

    # h = help (was ?)
    if key == "h":
        st.show_help      = not st.show_help
        st.show_cmd_pager = False
        return False

    # ? = full command pager -- runs inline (blocks until user quits)
    if key == "?":
        show_cmd_pager(term, c)
        return False

    # z = log pager -- runs inline (blocks until user quits)
    if key == "z":
        show_log_pager(term, c)
        return False

    if key == "i":
        c.inverted = not c.inverted
        term.invert_screen(c.inverted)
        return False

    if key == "b":
        c.bw = not c.bw
        c.apply_bw()
        return False

    if key in ("m", "M"):
        st.mode = {"ro": "mtm", "mtm": "vc", "vc": "ro"}.get(st.mode, "ro")
        return False

    if key == "u":
        st.unit = "us" if st.unit == "metric" else "metric"
        return False

    if key == "s":
        c.fancy = not c.fancy
        return False

    if key == "r":
        st.show_help      = False
        st.show_cmd_pager = False
        return True

    if key == "+":
        st.refresh_interval += 5
        if st.refresh_interval == 6:
            st.refresh_interval = 5
        return False

    if key == "-":
        st.refresh_interval -= 5
        if st.refresh_interval <= 1:
            st.refresh_interval = 1
        return False

    # Command hotkeys -- only when neither overlay is open
    cmd_keys = {"H", "f", "L", "l", "C", "c", "p", "P", "o", ":"}
    if (not st.show_help) and (not st.show_cmd_pager) and (key in cmd_keys):
        if client is None:
            msg    = "X TESLA_REFRESH_TOKEN missing"
            st.cmd_msg = f"h help    {c.RED}{msg}{c.R}"
            log_cmd(key, msg)
            return False
        if st.mode == "ro":
            msg    = "X no commands in ro mode (press m)"
            st.cmd_msg = f"h help    {c.RED}{msg}{c.R}"
            log_cmd(key, msg)
            return False

        if key == "H":
            st.cmd_msg = run_cmd(client, st, "honk_horn",              "NOOT NOOT!",      None, c)
        elif key == "f":
            st.cmd_msg = run_cmd(client, st, "flash_lights",            "Lights flashed",  None, c)
        elif key == "L":
            st.cmd_msg = run_cmd(client, st, "door_unlock",             "Unlocked",        None, c)
        elif key == "l":
            st.cmd_msg = run_cmd(client, st, "door_lock",               "Locked",          None, c)
        elif key == "C":
            st.cmd_msg = run_cmd(client, st, "auto_conditioning_start", "Climate on",      None, c)
        elif key == "c":
            st.cmd_msg = run_cmd(client, st, "auto_conditioning_stop",  "Climate off",     None, c)
        elif key == "p":
            st.cmd_msg = run_cmd(client, st, "charge_start",            "Charging started",None, c)
        elif key == "P":
            st.cmd_msg = run_cmd(client, st, "charge_stop",             "Charging stopped",None, c)
        elif key == "o":
            st.cmd_msg = run_cmd(client, st, "charge_port_door_open",   "Port opened",     None, c)
        elif key == ":":
            st.cmd_msg = parse_and_run_cmd(term, c, client, st)

        return True                         # force immediate refresh after any command

    return False


# =============================================================================
#  Main
# =============================================================================

def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("-m", "--mode",    default="mtm",    choices=["ro", "mtm", "vc"],
                    help="Where commands go (default: mtm)")
    ap.add_argument("-u", "--unit",    default="metric", choices=["metric", "us"])
    ap.add_argument("-r", "--refresh", type=int, default=5, metavar="SECONDS",
                    help="Refresh interval in s (default: 5)")
    ap.add_argument("-i", "--invert",  action="store_true")
    ap.add_argument("-s", "--simple",  action="store_true", help="Disable fancy style")
    ap.add_argument("-c", "--color",   action="store_true", help="Enable colors (default: off)")
    ap.add_argument("-b", "--bw",      action="store_true", help=argparse.SUPPRESS)  # now the default
    ap.add_argument("-l", "--login",   action="store_true",
                    help="Same as --login-tesla, then --login-mtm")
    ap.add_argument("--login-tesla",   action="store_true",
                    help="Sign in to Tesla and save a refresh token, then exit")
    ap.add_argument("--login-mtm",     action="store_true",
                    help="Save a MyTeslaMate token (from their Fleet page), then exit")
    ap.add_argument("--print",         action="store_true",
                    help="With --login-tesla: print the Tesla token instead of saving it")
    args = ap.parse_args()

    if args.login or args.login_tesla:
        return login(print_token=args.print, then_mtm=args.login and not args.print)
    if args.login_mtm:
        return login_mtm()

    st = State(
        mode=args.mode,
        unit=args.unit,
        refresh_interval=max(1, args.refresh),
        target_vin=os.environ.get("TESLA_VIN", "") or "",
        myteslamate_token=os.environ.get("MYTESLAMATE_TOKEN", "") or load_token(MTM_TOKEN_FILE),
        vehicle_command_url=os.environ.get("VEHICLE_COMMAND_URL", "https://localhost:4443") or "https://localhost:4443",
        vehicle_command_cert=os.environ.get("VEHICLE_COMMAND_CERT", "cert.pem") or "cert.pem",
    )

    # TESLA_REFRESH_TOKEN wins if set; the saved token is the fallback.
    env_token   = os.environ.get("TESLA_REFRESH_TOKEN", "") or ""
    saved_token = load_token()
    refresh_token = env_token or saved_token
    c = Colors(fancy=(not args.simple), inverted=bool(args.invert), bw=not args.color)

    term   = Term()
    client: Optional[TeslaClient] = None
    vid    = ""

    term.alt_screen(True)
    term.cursor(False)
    term.invert_screen(c.inverted)
    term.enable_raw()

    def cleanup() -> None:
        for fn in (
            lambda: term.disable_raw(),
            lambda: term.cursor(True),
            lambda: term.invert_screen(False),
            lambda: term.alt_screen(False),
        ):
            try: fn()
            except Exception: pass

    err = ""
    try:
        # DEMO MODE
        if not refresh_token:
            while True:
                if st.show_help:
                    render_help(term, c, st)
                elif st.show_cmd_pager:
                    render_dashboard(term, c, st, {"response": DEMO_DATA["response"]})
                    st.show_cmd_pager = False
                else:
                    render_dashboard(term, c, st, {"response": DEMO_DATA["response"]})
                key = term.read_key_timeout(st.refresh_interval)
                _   = handle_key(term, c, st, None, "", key)

        # LIVE MODE
        def keep_token(new_rt: str) -> None:
            try:
                save_token(new_rt)
            except OSError as e:
                log_cmd("token", f"X could not save refresh token: {e}")

        client = TeslaClient(refresh_token, on_rotate=keep_token)
        term.home(); term.clear_to_end()
        term.write("Authenticating…\n")
        try:
            client.refresh_access_token()
        except RuntimeError:
            # An env token goes stale once Tesla rotates it; the saved one is newer.
            if not (env_token and saved_token and saved_token != env_token):
                raise
            term.write("TESLA_REFRESH_TOKEN rejected, trying the saved token…\n")
            client.refresh_token = saved_token
            client.refresh_access_token()
        term.write("Looking up vehicle…\n")
        vid, vin = client.get_vehicle_id_and_vin(st.target_vin)

        if not st.target_vin and vin:
            st.target_vin = vin

        term.write(f"Connected: {st.target_vin or '?VIN?'} (vid {vid}) [{st.mode}]\n")
        if not vid:
            raise RuntimeError("No vehicle found -- check TESLA_VIN or token")

        time.sleep(0.5)

        data: Optional[Dict[str, Any]] = None
        _wake_attempt = 0   # counts consecutive failed wake cycles

        while True:
            # ── Try a quick data fetch first (car may already be awake) ──
            try:
                data = client.get_vehicle_data(vid)
            except Exception:
                data = None

            if not data:
                _wake_attempt += 1
                term.home(); term.clear_to_end()

                # Refresh the access token in case it expired while asleep
                try:
                    client.refresh_access_token()
                except Exception as e:
                    term.write(f"{c.YLW}Token refresh failed: {e!s:.60}  retrying…{c.R}\n")
                    time.sleep(5)
                    continue

                # Send wake command (best-effort; car may already be waking)
                try:
                    term.write(f"{c.YLW}Waking vehicle (attempt {_wake_attempt})…{c.R}\n")
                    client.wake_up(vid)
                except Exception as e:
                    term.write(f"{c.YLW}Wake request failed: {e!s:.60}{c.R}\n")
                    # Don't give up — network may still be coming up; keep polling

                # Poll for up to 60 s (20 × 3 s) before declaring this cycle failed
                for i in range(20):
                    time.sleep(3)
                    term.home(); term.clear_to_end()
                    term.write(
                        f"{c.YLW}Waiting for vehicle"
                        f" (cycle {_wake_attempt}, {(i+1)*3}s)…{c.R}\n"
                    )
                    try:
                        data = client.get_vehicle_data(vid)
                        if data:
                            break
                    except Exception:
                        pass

            if not data:
                # Exponential-ish backoff between wake cycles, capped at 30 s
                backoff = min(30, 5 * _wake_attempt)
                term.home(); term.clear_to_end()
                term.write(
                    f"{c.YLW}Vehicle unreachable after cycle {_wake_attempt}."
                    f" Retrying in {backoff}s…{c.R}\n"
                )
                time.sleep(backoff)
                continue

            _wake_attempt = 0   # reset on successful data fetch

            while True:
                if st.show_help:
                    render_help(term, c, st)
                elif st.show_cmd_pager:
                    render_dashboard(term, c, st, data)
                    st.show_cmd_pager = False
                else:
                    render_dashboard(term, c, st, data)

                key       = term.read_key_timeout(st.refresh_interval)
                fetch_now = handle_key(term, c, st, client, vid, key)
                if fetch_now:
                    break

    except KeyboardInterrupt:
        return 0
    except RuntimeError as e:
        err = str(e)
    finally:
        cleanup()

    # Only startup errors get here; the main loop retries on its own.
    print(f"tuisla: {err}", file=sys.stderr)
    if err.startswith(("HTTP 400", "HTTP 401", "Token refresh failed")):
        print("tuisla: the refresh token looks invalid -- run: tuisla --login-tesla", file=sys.stderr)
    elif err.startswith("HTTP 403"):
        print("tuisla: Tesla refused the Owner API access token. Check that `curl -V` lists\n"
              "        HTTP2 (tuisla renews tokens over TLS 1.3 + HTTP/2 with curl); if it\n"
              "        does, Tesla may have closed the Owner API for this account.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
