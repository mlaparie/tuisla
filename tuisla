def clamp_int(x: int, lo: int, hi: int) -> int:
    return lo if x < lo else hi if x > hi else x


def jget(d: Dict[str, Any], path: str, default: Any = None) -> Any:
    cur: Any = d
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


def _longest_common_prefix(strings: List[str]) -> str:
    """Return the longest string that is a prefix of every element."""
    if not strings:
        return ""
    prefix = strings[0]
    for s in strings[1:]:
        while not s.startswith(prefix):
            prefix = prefix[:-1]
            if not prefix:
                return ""
    return prefix


@dataclasses.dataclass
class Colors:
    fancy: bool = True
    inverted: bool = False
    bw: bool = False

    R:   str = "\x1b[0m"
    B:   str = "\x1b[1m"
    DIM: str = "\x1b[2m"
    REV: str = "\x1b[7m"

    RED: str = "\x1b[31m"
    GRN: str = "\x1b[32m"
    YLW: str = "\x1b[33m"
    BLU: str = "\x1b[34m"
    MAG: str = "\x1b[35m"
    CYN: str = "\x1b[36m"
    GRY: str = "\x1b[90m"

    _base: Dict[str, str] = dataclasses.field(default_factory=dict, init=False, repr=False)

    def __post_init__(self) -> None:
        self._base = {name: getattr(self, name) for name in
                      ("R", "B", "DIM", "REV", "RED", "GRN", "YLW", "BLU", "MAG", "CYN", "GRY")}
        self.apply_bw()

    def apply_bw(self) -> None:
        for name, code in self._base.items():
            setattr(self, name, code)
        if self.inverted:
            # Darker shades that stay readable on the light inverted background.
            self.YLW = "\x1b[38;5;136m"; self.GRN = "\x1b[38;5;28m"
            self.CYN = "\x1b[38;5;30m"
        if self.bw:
            self.RED = ""; self.GRN = ""; self.YLW = ""
            self.BLU = ""; self.MAG = ""; self.CYN = ""
            self.GRY = "\x1b[90m"


_utf8 = codecs.getincrementaldecoder("utf-8")("replace")


def read_char() -> str:
    """One character from the keyboard.  Unlike sys.stdin.read(1), this keeps
    no buffer of its own, so select() on stdin still sees keys typed or pasted
    in one go."""
    while True:
        b = os.read(sys.stdin.fileno(), 1)
        if not b:
            return "\x1b"                   # stdin closed: act like Esc
        ch = _utf8.decode(b)
        if ch:
            return ch


_KEY_SEQS = {"A": "k", "B": "j", "5~": "u", "6~": "d", "H": "g", "F": "G",
             "1~": "g", "4~": "G", "7~": "g", "8~": "G"}


def read_key(pager: bool = True) -> str:
    """Like read_char, but the arrow keys (and PgUp/PgDn, Home/End) come back
    as the pager's j/k (u/d, g/G), or as "" when typing (pager=False), like
    other key sequences; a lone Esc stays Esc."""
    import select as _sel
    ch = read_char()
    if ch != "\x1b" or not _sel.select([sys.stdin], [], [], 0.05)[0]:
        return ch
    if read_char() not in ("[", "O"):
        return ""
    seq = ""
    while len(seq) < 8:
        seq += read_char()
        if "\x40" <= seq[-1] <= "\x7e":
            break
    return _KEY_SEQS.get(seq, "") if pager else ""


# Inverted screen: dark text on a light background.  Drawn by tuisla itself
# rather than with the terminal's screen-reverse mode (ESC [?5h), which tmux,
# eat and others ignore.  Erasing also uses this background in those terminals.
INVERT_SGR = "\x1b[30;107m"


class Term:
    def __init__(self) -> None:
        self.is_windows = (os.name == "nt")
        self._raw_enabled = False
        self._old_termios = None
        self.inverted = False

    def write(self, s: str) -> None:
        if self.inverted:
            # Every color reset falls back to the inverted colors.
            s = s.replace("\x1b[0m", "\x1b[0m" + INVERT_SGR)
        sys.stdout.write(s)
        sys.stdout.flush()

    def get_size(self) -> Tuple[int, int]:
        try:
            sz = shutil.get_terminal_size(fallback=(80, 24))
            return (sz.columns, sz.lines)
        except Exception:
            return (80, 24)

    def alt_screen(self, on: bool) -> None:
        self.write("\x1b[?1049h" if on else "\x1b[?1049l")

    def cursor(self, on: bool) -> None:
        self.write("\x1b[?25h" if on else "\x1b[?25l")

    def invert_screen(self, on: bool) -> None:
        self.inverted = on
        self.write("\x1b[0m")       # applies (or drops) INVERT_SGR; the next redraw fills the screen

    def home(self) -> None:
        self.write("\x1b[H")

    def clear_to_end(self) -> None:
        self.write("\x1b[J")

    def clear_line(self) -> None:
        self.write("\x1b[2K\r")

    def move(self, row0: int, col0: int) -> None:
        self.write(f"\x1b[{row0+1};{col0+1}H")

    def enable_raw(self) -> None:
        if self.is_windows:
            self._raw_enabled = True
            return
        if self._raw_enabled:
            return
        import termios, tty
        fd = sys.stdin.fileno()
        self._old_termios = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        self._raw_enabled = True

    def disable_raw(self) -> None:
        if self.is_windows:
            self._raw_enabled = False
            return
        if not self._raw_enabled:
            return
        import termios
        fd = sys.stdin.fileno()
        if self._old_termios is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, self._old_termios)
        self._raw_enabled = False

    def read_key_timeout(self, timeout_s: int) -> Optional[str]:
        if self.is_windows:
            import msvcrt
            end = time.time() + timeout_s
            while time.time() < end:
                if msvcrt.kbhit():
                    ch = msvcrt.getwch()
                    if ch == "\r":
                        return "\n"
                    return ch
                time.sleep(0.01)
            return None
        else:
            import select, signal
            # Self-pipe trick: SIGWINCH wakes select() so resize redraws immediately.
            pipe_r, pipe_w = os.pipe()
            def _sigwinch(signum: int, frame: Any) -> None:
                try:
                    os.write(pipe_w, b"\x00")
                except OSError:
                    pass
            old_handler = signal.signal(signal.SIGWINCH, _sigwinch)
            try:
                r, _, _ = select.select([sys.stdin, pipe_r], [], [], timeout_s)
                if pipe_r in r:
                    try:
                        os.read(pipe_r, 64)
                    except OSError:
                        pass
                    return None
                if not r:
                    return None
                return read_char()
            finally:
                signal.signal(signal.SIGWINCH, old_handler)
                os.close(pipe_r)
                os.close(pipe_w)


@dataclasses.dataclass
class Frame:
    content_w: int
    lbl_w: int = 9
    cat_labels: bool = False

    lines: List[str] = dataclasses.field(default_factory=list)
    maxvis: int = 0

    def fline(self, s: str = "") -> None:
        self.lines.append(s)
        self.maxvis = max(self.maxvis, vlen(s))

    def blank(self) -> None:
        self.fline("")

    def row2(self, c: Colors, ll: str, vl: str, lr: str, vr: str) -> None:
        half = self.content_w // 2

        def label_cell(txt: str) -> str:
            if c.fancy and self.cat_labels:
                return f"{c.GRY}{c.REV} {txt:<{self.lbl_w-1}}{c.R}"
            return f"{c.GRY}{txt:<{self.lbl_w}}{c.R}"

        left  = f"{label_cell(ll)} {vl}"
        right = f"{label_cell(lr)} {vr}"
        lvis  = vlen(left)
        pad   = max(0, half - lvis - 2)
        self.fline(f"  {left}{' ' * pad}  {right}")

    def row1(self, c: Colors, label: str, val: str) -> None:
        if c.fancy and self.cat_labels:
            lab = f"{c.GRY}{c.REV} {label:<{self.lbl_w-1}}{c.R}"
        else:
            lab = f"{c.GRY}{label:<{self.lbl_w}}{c.R}"
        self.fline(f"  {lab} {val}")

    def section(self, c: Colors, title: str) -> None:
        self.blank()
        self.fline(f"  {c.B}{c.MAG}{title}{c.R}")


MSG_SECONDS = 3                  # a command's result stays at least this long
ROUTE_WATCH = 120                # s to keep asking for the route after sending one
WATCH       = 90                 # s to keep fetching after a command, until the car shows it
WAKE_EVERY  = 30                 # s between wake requests while keeping an unreachable car awake

_MIN_TERM_W = 64
_MIN_TERM_H = 21
_TOO_SMALL_MSG_W = "Window too narrow: 64x21 required"
_TOO_SMALL_MSG_H = "Window too short: 64x21 required"


def flush_frame(term: Term, c: Colors, frame: Frame) -> int:
    """Write frame to terminal. Returns the 0-based row of the last line written."""
    term_w, term_h = term.get_size()

    if term_w < _MIN_TERM_W or term_h < _MIN_TERM_H:
        if term_w < _MIN_TERM_W:
            msg = f"{_TOO_SMALL_MSG_W} (now {term_w}x{term_h})"
        else:
            msg = f"{_TOO_SMALL_MSG_H} (now {term_w}x{term_h})"
        term.home()
        term.clear_to_end()
        msg_vis  = vlen(msg)
        h_margin = max(0, (term_w - msg_vis) // 2)
        v_margin = max(0, (term_h - 1) // 2)
        term.move(v_margin, 0)
        term.write(f"{' ' * h_margin}{c.YLW}{c.B}{msg}{c.R}\n")
        return v_margin

    w        = min(frame.maxvis, term_w)
    h_margin = max(0, (term_w - w) // 2)
    v_margin = max(0, (term_h - len(frame.lines)) // 2)
    term.home()
    term.clear_to_end()
    term.move(v_margin, 0)
    for line in frame.lines:
        term.write((" " * h_margin) + line + c.R + "\n")
    return v_margin + len(frame.lines) - 1


def two_col_title(content_w: int, left: str, right: str) -> str:
    half        = content_w // 2
    lvis        = vlen(left)
    gap         = max(2, half - lvis)
    return f"{left}{' ' * gap}{right}"


# =============================================================================
#  Token storage, in $XDG_STATE_HOME/tuisla/ (files mode 600, dir 700):
#    refresh_token       Tesla may hand out a new one on every refresh, so the
#                        latest one is kept here.
#    myteslamate_token   Copied by the user from the MyTeslaMate dashboard.
#    access_token        The last access token (valid ~8 h), so that starting
#                        again soon skips a round trip to auth.tesla.com.
# =============================================================================

MTM_TOKEN_FILE = "myteslamate_token"
MTM_API_URL    = "https://app.myteslamate.com/fleet"   # the "API" tab
MTM_API        = "https://api.myteslamate.com/api/1"


def token_path(name: str = "refresh_token") -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "tuisla", name)


def load_token(name: str = "refresh_token") -> str:
    path = token_path(name)
    try:
        info = os.stat(path)
    except FileNotFoundError:
        return ""
    if info.st_mode & 0o077 or info.st_uid != os.getuid():
        die(f"Refusing to use {path}: it must be owned by you and not readable by "
            f"others (chmod 600 {path})")
    with open(path, encoding="utf-8") as f:
        return f.read().strip()


def save_token(token: str, name: str = "refresh_token") -> None:
    path = token_path(name)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    # mkstemp creates the file with mode 600; rename it over the old one so a
    # crash never leaves a half-written token behind.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=f".{name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(token + "\n")
        os.replace(tmp, path)
    except BaseException:
        try: os.remove(tmp)
        except OSError: pass
        raise


# =============================================================================
#  Login (OAuth2 PKCE) -- stores a refresh token (see token_path)
# =============================================================================

def _b64url(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


class _CallbackCatcher:
    """Temporarily makes us the desktop handler for tesla:// links (Linux, via
    xdg-mime) so the browser hands over the login callback. close() restores
    the previous handler."""

    SCHEME = "x-scheme-handler/tesla"

    def __init__(self) -> None:
        self.tmp     = ""
        self.out     = ""
        self.name    = f"tuisla-login-{os.getpid()}.desktop"
        self.apps    = os.path.join(os.environ.get("XDG_DATA_HOME")
                                    or os.path.expanduser("~/.local/share"), "applications")
        self.desktop = os.path.join(self.apps, self.name)
        self.prev    = ""
        self.armed   = False

    def _xdg(self, *args: str) -> str:
        return subprocess.run(["xdg-mime", *args], check=True, capture_output=True,
                              text=True, timeout=10).stdout.strip()

    def arm(self) -> bool:
        if not sys.platform.startswith("linux") or not shutil.which("xdg-mime"):
            return False
        try:
            # Query before our .desktop file exists: with no default set,
            # xdg-mime falls back to any file that lists the scheme.
            self.prev = self._xdg("query", "default", self.SCHEME)
            if self.prev == self.name:
                self.prev = ""
            self.tmp = tempfile.mkdtemp(prefix="tuisla-login-")
            self.out = os.path.join(self.tmp, "callback.txt")
            helper   = os.path.join(self.tmp, "callback.sh")
            # xdg-open's generic mode splits Exec= on spaces and ignores quotes.
            if not re.fullmatch(r"[A-Za-z0-9._/-]+", helper):
                raise RuntimeError("temp path needs quoting")
            with open(helper, "w") as f:
                f.write(f"#!/bin/sh\nprintf '%s' \"$1\" > {shlex.quote(self.out)}\n")
            os.chmod(helper, 0o700)
            os.makedirs(self.apps, exist_ok=True)
            with open(self.desktop, "w") as f:
                f.write("[Desktop Entry]\n"
                        "Type=Application\n"
                        "Name=tuisla login callback\n"
                        f"Exec={helper} %u\n"
                        "NoDisplay=true\n"
                        "Terminal=false\n"
                        f"MimeType={self.SCHEME};\n")
            self.armed = True
            self._xdg("default", self.name, self.SCHEME)
            return True
        except Exception:
            self.close()
            return False

    def wait(self, timeout: float) -> str:
        end = time.time() + timeout
        while time.time() < end:
            try:
                with open(self.out) as f:
                    got = f.read().strip()
                if got:
                    return got
            except OSError:
                pass
            time.sleep(0.5)
        return ""

    def close(self) -> None:
        if self.armed:
            self.armed = False
            try:
                if self.prev:
                    self._xdg("default", self.prev, self.SCHEME)
                else:
                    # xdg-mime cannot unset a default; drop our line by hand.
                    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
                    for path in (os.path.join(cfg, "mimeapps.list"),
                                 os.path.join(self.apps, "mimeapps.list")):
                        try:
                            with open(path) as f:
                                lines = f.readlines()
                        except OSError:
                            continue
                        keep = [ln for ln in lines
                                if not (ln.startswith(self.SCHEME + "=") and self.name in ln)]
                        if keep != lines:
                            with open(path, "w") as f:
                                f.writelines(keep)
            except Exception:
                pass
        for fn in (lambda: os.remove(self.desktop),
                   lambda: shutil.rmtree(self.tmp) if self.tmp else None):
            try: fn()
            except Exception: pass


def parse_callback(pasted: str, state: str, redirect: str, authorize_url: str) -> Dict[str, List[str]]:
    """Parameters of a pasted OAuth callback URL (or of a bare code), with a
    'code'.  Raises ValueError saying what is wrong with it."""
    # Drop terminal escapes (e.g. bracketed-paste markers), whitespace and quotes,
    # undo JSON escaping, then read parameters from the query and the fragment.
    pasted = re.sub(r"\x1b\[[0-9;]*~?|\s", "", pasted).strip("'\",")
    pasted = pasted.replace("\\/", "/").replace("\\u0026", "&")
    if re.fullmatch(r"[A-Za-z0-9._~-]+", pasted):
        print("! Got a bare code; skipping the state check", file=sys.stderr)
        pasted = f"{redirect}?code={pasted}&state={state}"
    parts  = urllib.parse.urlparse(pasted)
    query  = urllib.parse.parse_qs(parts.query)
    for k, v in urllib.parse.parse_qs(parts.fragment).items():
        query.setdefault(k, v)
    if not (query.get("code") or [""])[0]:
        err = (query.get("error_description") or query.get("error") or [""])[0]
        if err:
            raise ValueError(f"Tesla returned an error: {err}")
        if pasted.startswith(authorize_url):
            raise ValueError("That is the sign-in URL -- paste the Location of the 302 redirect instead")
        seen = ", ".join(sorted(query)) or "none"
        raise ValueError(f"No 'code' parameter in that URL"
                         f" (page: {parts.netloc}{parts.path or '/'}; parameters: {seen})\n"
                         f"  Expected a URL starting with {redirect}?...code=...")
    if (query.get("state") or [""])[0] != state:
        raise ValueError("State mismatch -- paste the URL from this login attempt")
    return query


def login(print_token: bool = False, then_mtm: bool = True) -> int:
    # Prompts go to stderr so that with --print stdout carries only the token.
    def say(msg: str = "") -> None:
        print(msg, file=sys.stderr, flush=True)

    verifier  = _b64url(secrets.token_bytes(64))
    challenge = _b64url(hashlib.sha256(verifier.encode("ascii")).digest())
    state     = _b64url(secrets.token_bytes(16))
    url = AUTHORIZE_URL + "?" + urllib.parse.urlencode({
        "client_id":             OWNER_CLIENT_ID,
        "code_challenge":        challenge,
        "code_challenge_method": "S256",
        "redirect_uri":          LOGIN_REDIRECT,
        "response_type":         "code",
        "scope":                 "openid email offline_access",
        "state":                 state,
    }, quote_via=urllib.parse.quote)

    # Tesla sends the browser to tesla://auth/callback?code=..., which a desktop
    # browser cannot open. Catch it with a temporary tesla:// handler if we can,
    # otherwise the user copies it out of DevTools.
    catcher = _CallbackCatcher()
    pasted  = ""
    try:
        auto = catcher.arm()
        say("Sign in to your Tesla account in the browser window that opens.")
        say("If no browser opens, use this URL:\n")
        say(f"   {url}\n")
        try:
            webbrowser.open(url)
        except Exception:
            pass
        if auto:
            say("After signing in, allow the browser to open the tesla:// link")
            say("(with 'tuisla login callback'). Waiting up to 5 min; Ctrl-C to paste instead.")
            try:
                pasted = catcher.wait(300)
            except KeyboardInterrupt:
                say()
    finally:
        catcher.close()

    if not pasted:
        say("\nTo copy the link by hand: open DevTools (F12) > Network BEFORE signing in")
        say("and keep it open. After signing in, search the Network panel")
        say(f"(magnifier icon / Ctrl+Shift+F) for '{LOGIN_REDIRECT}' and copy that")
        say("whole link from the matching response, or just the value after 'code='.\n")
        try:
            sys.stderr.write("Callback URL or code: "); sys.stderr.flush()
            pasted = input().strip()
        except (EOFError, KeyboardInterrupt):
            say()
            return 1

    try:
        query = parse_callback(pasted, state, LOGIN_REDIRECT, AUTHORIZE_URL)
    except ValueError as e:
        say(f"X {e}")
        return 1
    code = query["code"][0]

    # Accounts in China are served by auth.tesla.cn; the redirect names the issuer.
    issuer    = (query.get("issuer") or [""])[0].rstrip("/")
    token_url = (issuer + "/token") if issuer.startswith("https://auth.tesla.") else AUTH_URL

    try:
        resp = auth_post(token_url, {
            "grant_type":    "authorization_code",
            "client_id":     OWNER_CLIENT_ID,
            "code":          code,
            "code_verifier": verifier,
            "redirect_uri":  LOGIN_REDIRECT,
        })
    except RuntimeError as e:
        say(f"X Token exchange failed: {e}")
        return 1

    rt = resp.get("refresh_token") or ""
    if not rt:
        say("X Token exchange failed (missing refresh_token)")
        return 1
    if print_token:
        say("\nOK. Refresh token (keep it secret):\n")
        print(rt, flush=True)
        return 0
    try:
        save_token(rt)
    except OSError as e:
        say(f"X Could not save the token to {token_path()}: {e}")
        return 1
    say(f"\nOK. Saved to {token_path()}")
    if os.environ.get("TESLA_REFRESH_TOKEN"):
        say("! TESLA_REFRESH_TOKEN is set and is tried first; unset it to use the saved token.")
    if not then_mtm:
        return 0
    say("\nTo send commands to the car, tuisla needs one of these (you can set up the\n"
        "other later):\n"
        "  1. MyTeslaMate API: easy, sign in there and paste a token here; pay as you\n"
        "     go, about 1 EUR for 500 commands a month.\n"
        "  2. vehicle-command (vc mode): free for a personal car (Tesla's monthly $10\n"
        "     credit covers it), but about 20 minutes to set up once: your own key,\n"
        "     a free GitHub Pages site and a Tesla developer account with a payment\n"
        "     card.  Also works over Bluetooth when there is no network.\n"
        "  3. Neither for now: read-only.")
    try:
        choice = input("Your choice [1]: ").strip() or "1"
    except (EOFError, KeyboardInterrupt):
        say()
        return 0
    if choice == "2":
        setup_vc()
    return login_mtm() if choice == "1" else 0


def setup_vc() -> None:
    """Run the vc mode setup, which lives in its own script next to this one."""
    script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "tuisla-setup-vc")
    if not os.path.exists(script):
        die(f"{script} is missing; get it from the tuisla repository, next to tuisla")
    os.execv(sys.executable, [sys.executable, script])


def login_mtm() -> int:
    # MyTeslaMate has no API to hand out its token: it is shown in their web
    # app after signing in there with the Tesla account, so open it and have
    # the user paste the token.
    def say(msg: str = "") -> None:
        print(msg, file=sys.stderr, flush=True)

    say("MyTeslaMate token (used to send commands in mtm mode):")
    say(f"1. Sign in to MyTeslaMate with your Tesla account; this opens the API tab:\n\n   {MTM_API_URL}\n")
    say("2. Allow commands for your vehicle.")
    say("3. Copy the MyTeslaMate API token (not the Fleet API one) and paste it here.\n")
    try:
        webbrowser.open(MTM_API_URL)
    except Exception:
        pass
    try:
        tok = getpass.getpass("Paste the token (hidden; Enter to skip): ", stream=sys.stderr)
    except (EOFError, KeyboardInterrupt):
        say()
        return 1
    tok = re.sub(r"\x1b\[[0-9;]*~?|\s", "", tok).strip("'\"")
    if "token=" in tok:                      # a pasted ...?token=XXXX URL
        tok = urllib.parse.parse_qs(urllib.parse.urlparse(tok).query
                                    or tok.split("?", 1)[-1]).get("token", [""])[0]
    if not tok:
        say("Skipped; mtm commands need it (run: tuisla --login-mtm).")
        return 0
    if not re.fullmatch(r"[A-Za-z0-9._~-]+", tok):
        say("X That doesn't look like a MyTeslaMate token (expected letters, digits, '-')")
        return 1
    try:
        save_token(tok, MTM_TOKEN_FILE)
    except OSError as e:
        say(f"X Could not save the token to {token_path(MTM_TOKEN_FILE)}: {e}")
        return 1
    say(f"OK. Saved to {token_path(MTM_TOKEN_FILE)} -- just run tuisla now.")
    if os.environ.get("MYTESLAMATE_TOKEN"):
        say("! MYTESLAMATE_TOKEN is set and is used instead; unset it to use the saved token.")
    return 0


# =============================================================================
#  Tesla API client
# =============================================================================

def auth_post(url: str, form: Dict[str, str]) -> Dict[str, Any]:
    """POST a form to auth.tesla.com.  Since mid-2026 Tesla only issues tokens
    that owner-api accepts when this request uses TLS 1.3 and HTTP/2 (other
    clients get HTTP 403 "forbidden, see .../fleet-api" afterwards).  Python's
    stdlib has no HTTP/2, so use curl; fall back to urllib with TLS 1.3."""
    if shutil.which("curl"):
        def q(v: str) -> str:
            return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
        # Secrets go in a config on stdin so they never show up in `ps`.
        cfg = [f"url = {q(url)}", 'header = "Content-Type: application/x-www-form-urlencoded"']
        cfg += [f"data-urlencode = {q(k + '=' + v)}" for k, v in form.items()]
        try:
            out = subprocess.run(
                ["curl", "-sS", "--http2", "--tlsv1.3", "--max-time", "20",
                 "-w", "\n%{http_code}", "-K", "-"],
                input="\n".join(cfg) + "\n", capture_output=True, text=True, timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as e:
            raise RuntimeError(f"curl failed: {e}") from e
        if out.returncode != 0:
            raise RuntimeError(f"curl failed: {out.stderr.strip()[:200]}")
        body, _, code = out.stdout.rpartition("\n")
        if not code.startswith("2"):
            raise RuntimeError(f"HTTP {code}: {body[:300]}")
        try:
            return json.loads(body) if body else {}
        except ValueError as e:
            raise RuntimeError(f"Bad response from {url}: {body[:200]}") from e

    ctx = ssl.create_default_context()
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    req = urllib.request.Request(
        url, method="POST", data=urllib.parse.urlencode(form).encode("utf-8"),
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    return TeslaClient("")._http(req, ctx=ctx)


class TeslaClient:
    """Owner API client by default; with the Fleet API arguments it talks to
    the Fleet API with a token from the developer app made by --setup-vc."""

    def __init__(self, refresh_token: str,
                 on_rotate: Optional[Callable[[str], None]] = None, *,
                 api_base: str = OWNER_API, client_id: str = OWNER_CLIENT_ID,
                 token_url: str = AUTH_URL, scope: str = "openid email offline_access",
                 cache: str = "") -> None:
        self.refresh_token = refresh_token
        self.access_token  = ""
        self.on_rotate     = on_rotate     # called with each new refresh token
        self.api_base      = api_base
        self.client_id     = client_id
        self.token_url     = token_url
        self.scope         = scope
        self.cache         = cache         # token file keeping the access token between runs

    def _http(self, req: urllib.request.Request,
              ctx: Optional[ssl.SSLContext] = None) -> Dict[str, Any]:
        try:
            with urllib.request.urlopen(req, context=ctx, timeout=20) as r:
                data = r.read().decode("utf-8", "replace")
                return json.loads(data) if data else {}
        except urllib.error.HTTPError as e:
            body = e.read().decode("utf-8", "replace") if hasattr(e, "read") else ""
            raise RuntimeError(f"HTTP {e.code}: {body[:300]}") from e
        except Exception as e:
            raise RuntimeError(str(e)) from e

    def refresh_access_token(self) -> None:
        form = {"grant_type": "refresh_token", "client_id": self.client_id,
                "refresh_token": self.refresh_token}
        if self.scope:
            form["scope"] = self.scope
        resp = auth_post(self.token_url, form)
        at   = resp.get("access_token") or ""
        if not at:
            raise RuntimeError("Token refresh failed (missing access_token)")
        self.access_token = at
        new_rt = resp.get("refresh_token") or ""
        if new_rt and new_rt != self.refresh_token:
            self.refresh_token = new_rt
            if self.on_rotate:
                self.on_rotate(new_rt)
        if self.cache:
            try:
                save_token(json.dumps({"access_token": at, "for": self._rt_id(),
                                       "expires_at": time.time() + float(resp.get("expires_in") or 0)}),
                           self.cache)
            except OSError:
                pass

    def _rt_id(self) -> str:
        return hashlib.sha256(self.refresh_token.encode()).hexdigest()[:16]

    def use_cached_token(self) -> bool:
        """Reuse the access token saved by an earlier run, if it was made from
        this refresh token and has at least 10 minutes left."""
        try:
            got = json.loads(load_token(self.cache) or "{}") if self.cache else {}
        except ValueError:
            return False
        if got.get("for") == self._rt_id() and float(got.get("expires_at") or 0) > time.time() + 600:
            self.access_token = got.get("access_token") or ""
        return bool(self.access_token)

    def _request(self, method: str, url: str, body: Optional[Dict[str, Any]],
                 ctx: Optional[ssl.SSLContext], bearer: Optional[str]) -> Dict[str, Any]:
        headers = {"Content-Type": "application/json", "User-Agent": "tuisla/1.0"}
        bearer  = self.access_token if bearer is None else bearer
        if bearer:
            headers["Authorization"] = f"Bearer {bearer}"
        payload = json.dumps(body).encode("utf-8") if body else (b"" if method == "POST" else None)
        req = urllib.request.Request(url, method=method, data=payload, headers=headers)
        return self._http(req, ctx=ctx)

    def api_get(self, path: str) -> Dict[str, Any]:
        return self._request("GET", self.api_base + path, None, None, None)

    def api_post(self, url: str, body: Optional[Dict[str, Any]] = None,
                 ctx: Optional[ssl.SSLContext] = None, bearer: Optional[str] = None) -> Dict[str, Any]:
        """POST to a full URL; bearer overrides our access token ("" sends none)."""
        return self._request("POST", url, body, ctx, bearer)

    def get_vehicle_id_and_vin(self, target_vin: str) -> Tuple[str, str]:
        items = self.api_get("/products").get("response") or []
        cars  = [it for it in items if isinstance(it, dict) and it.get("vin")] if isinstance(items, list) else []
        for it in cars:
            if not target_vin or it["vin"] == target_vin:
                return (str(it.get("id_s") or it.get("id") or ""), str(it["vin"]))
        return ("", "")

    def wake_up(self, vid: str) -> None:
        try:
            self.api_post(f"{self.api_base}/vehicles/{vid}/wake_up")
        except Exception:
            pass

    def get_state(self, vid: str) -> str:
        """online, asleep or offline; asking neither wakes the car nor keeps it awake."""
        return str(jget(self.api_get(f"/vehicles/{vid}"), "response.state", "") or "unknown")

    def get_vehicle_data(self, vid: str, location: bool = False) -> Optional[Dict[str, Any]]:
        # The location (and route) is slower to get, so it is only asked for when needed.
        q = ("?endpoints=" + urllib.parse.quote("charge_state;climate_state;drive_state;gui_settings;"
                                                "vehicle_config;vehicle_state;location_data")) if location else ""
        resp = self.api_get(f"/vehicles/{vid}/vehicle_data{q}")
        vin  = jget(resp, "response.vin", "")
        return resp if vin else None


